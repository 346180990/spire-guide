<view class="page-wrap">

  <view wx:if="{{error}}" class="info-bar danger-bar">
    <view>{{error}}</view>
    <view class="mt8"><button class="btn btn-small" bindtap="load">重试</button></view>
  </view>

  <!-- 结论区：先给结论，再给证据 -->
  <view class="card">
    <view class="row between">
      <view class="flex1">
        <view class="sub">当前策略结论</view>
        <view class="hero-num mt8 {{conclusion === 'buy' ? 'up' : conclusion === 'sell' ? 'down' : conclusion === 'unavailable' ? 'warn' : ''}}">{{conclusionText}}</view>
        <view class="sub mt8">{{reason}}</view>
      </view>
      <status-pill text="{{statusLabel}}" tone="{{statusTone}}" />
    </view>

    <view class="pill pill-muted mt12">模拟信号，不会自动下单</view>

    <view class="divider"></view>

    <!-- 三个时间必须同时出现 -->
    <view class="row between">
      <view class="flex1">
        <view class="tiny">数据截至</view>
        <view class="bold mono">{{dataAsOf}}</view>
      </view>
      <view class="flex1">
        <view class="tiny">计算完成</view>
        <view class="bold mono">{{computedAt}}</view>
      </view>
      <view class="flex1">
        <view class="tiny">信号适用</view>
        <view class="bold mono">{{appliesTo}}</view>
      </view>
    </view>

    <view wx:if="{{stale}}" class="info-bar warn-bar mt12">行情不是最新交易日，该信号已标记为「数据延迟」，不视为当日有效信号。</view>
  </view>

  <view class="card card-flat">
    <view class="row between">
      <view class="flex1">
        <view class="tiny">参数版本</view>
        <view class="bold">{{configVersion}}</view>
        <view class="tiny mt8">{{configBrief}}</view>
      </view>
      <button class="btn btn-secondary btn-small" bindtap="goParams">调整参数</button>
    </view>
    <view class="tiny mt8">代码版本 {{codeVersion}}</view>
  </view>

  <view wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view class="row between mb8">
      <text class="title-sm">{{group.title}}</text>
      <text class="tiny">{{group.hint}}</text>
    </view>
    <view class="card">
      <view wx:for="{{group.items}}" wx:key="symbol" wx:for-item="it">
        <view class="row-top between">
          <view class="flex1">
            <view class="title-sm">
              {{it.name}}
              <text class="pill pill-{{it.tone}}">{{it.actionLabel}}</text>
            </view>
            <view class="tiny mt8">{{it.symbol}} · 指标 {{it.valueText}} · 阈值 {{it.up}} / {{it.dn}}</view>
            <view class="sub mt8">{{it.reason}}</view>
            <view class="tiny mt8">数据截至 {{it.dataAsOf}} · 适用 {{it.appliesTo}}</view>
          </view>
          <view style="text-align:right;margin-left:16rpx">
            <view class="tiny">R²</view>
            <view class="bold mono">{{it.r2Text}}</view>
          </view>
        </view>
        <view class="divider"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{!hasAny && !loading}}" class="card">
    <view class="empty">
      <view class="empty-title">没有可展示的信号</view>
      <view>先检查数据时间与运行记录；若显示「不可计算」，说明历史行情长度不足。</view>
      <view class="mt16"><button class="btn btn-small" bindtap="goBacktestRuns">查看运行记录</button></view>
    </view>
  </view>

  <view class="row gap12 mt16">
    <button class="btn btn-secondary flex1" bindtap="goReplay">历史信号</button>
    <button class="btn flex1" bindtap="goBacktest">运行回测</button>
  </view>
  <view class="row gap12 mt12">
    <button class="btn btn-ghost flex1" bindtap="goParams">调整参数</button>
    <button class="btn btn-ghost flex1" bindtap="goBacktestRuns">运行历史</button>
  </view>
</view>
