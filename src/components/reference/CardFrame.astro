---
// CardFrame.astro — Card display with base/upgraded toggle
import EnergyOrb from '../icons/EnergyOrb.astro';
import CardTypeIcon from '../icons/CardTypeIcon.astro';
import RarityIcon from '../icons/RarityIcon.astro';

export interface Props {
  name: string;
  type: string;
  character: string;
  rarity: string;
  cost: number | string;
  image?: string;
  upgradedCost?: number | string;
  upgradedEffect?: string;
}

const { name, type, character, rarity, cost, image, upgradedCost, upgradedEffect } = Astro.props;

const characterGradients: Record<string, string> = {
  Ironclad: 'linear-gradient(135deg, #7f1d1d 0%, #9a3412 40%, #c2410c 100%)',
  Silent: 'linear-gradient(135deg, #14532d 0%, #166534 40%, #15803d 100%)',
  Defect: 'linear-gradient(135deg, #1e3a5f 0%, #1e40af 40%, #2563eb 100%)',
  Regent: 'linear-gradient(135deg, #713f12 0%, #92400e 40%, #d97706 100%)',
  Necrobinder: 'linear-gradient(135deg, #3b0764 0%, #581c87 40%, #7c3aed 100%)',
  Colorless: 'linear-gradient(135deg, #374151 0%, #4b5563 40%, #6b7280 100%)',
};

const defaultGradient = 'linear-gradient(135deg, #1f2937 0%, #374151 40%, #4b5563 100%)';
const gradient = characterGradients[character] || defaultGradient;
const isNonPlayable = type === 'Status' || type === 'Curse';
const artOpacity = isNonPlayable ? 'opacity-60' : '';

const rarityGlowClass: Record<string, string> = {
  Common: 'card-glow-common',
  Uncommon: 'card-glow-uncommon',
  Rare: 'card-glow-rare',
  Boss: 'card-glow-boss',
  Starter: 'card-glow-starter',
  Special: 'card-glow-special',
};
const glowClass = rarityGlowClass[rarity] || '';

const hasUpgrade = upgradedEffect && upgradedEffect.length > 0;
const displayUpgCost = upgradedCost !== undefined ? upgradedCost : cost;
---

<div class={`bg-surface border border-border rounded-xl overflow-hidden max-w-md w-full mx-auto ${glowClass}`}>
  <!-- Energy cost orb -->
  <div class="relative">
    <div class="absolute top-3 left-3 z-10">
      <EnergyOrb cost={cost} size="md" character={character} />
    </div>

    <!-- Card Art -->
    <div
      class={`relative h-48 md:h-56 flex items-center justify-center overflow-hidden ${artOpacity}`}
      style={`background: ${gradient};`}
    >
      {image ? (
        <img
          src={image}
          alt={name}
          width="400"
          height="224"
          class="relative z-10 w-full h-full object-contain"
          onerror={`this.style.display='none';this.parentElement.querySelector('.fallback-icon').style.display='flex';`}
        />
      ) : null}
      <div class="absolute inset-0 bg-noise"></div>
      <div class="absolute inset-0 items-center justify-center z-0 fallback-icon" class:list={[{ 'hidden': !!image, 'flex': !image }]}>
        <div class="text-white/30">
          <CardTypeIcon type={type} size="lg" />
        </div>
      </div>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5">
    <h2 class="text-xl md:text-2xl text-text mb-3 leading-tight" style="font-family: var(--font-display);">
      {name}
    </h2>

    <div class="w-full h-px bg-border mb-3"></div>

    <!-- Badges -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full border bg-blue-900/40 text-blue-300 border-blue-800">
        <CardTypeIcon type={type} size="sm" />
        <span>{type}</span>
      </span>
      <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full border bg-amber-900/40 text-amber-300 border-amber-800">
        <RarityIcon rarity={rarity} size="sm" />
        <span>{rarity}</span>
      </span>
      <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full border bg-purple-900/40 text-purple-300 border-purple-800">
        <span>{character}</span>
      </span>
    </div>

    <div class="w-full h-px bg-border mb-3"></div>

    <!-- Effect Text -->
    <div class="text-sm text-text-muted leading-relaxed">
      <slot name="effect" />
    </div>

    <!-- Upgraded Version -->
    {hasUpgrade && (
      <div>
        <div class="w-full h-px bg-border my-4"></div>
        <div class="bg-green-950/30 border border-green-800/40 rounded-lg p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-bold px-2 py-0.5 rounded bg-green-800/50 text-green-300">UPGRADED</span>
            <span class="text-sm font-semibold text-green-200">{name}+</span>
            {displayUpgCost !== cost && (
              <span class="text-xs text-green-300 ml-auto">
                Cost: {cost} → <span class="font-bold">{displayUpgCost}</span>
              </span>
            )}
          </div>
          <div class="flex items-start gap-3">
            <!-- Upgraded energy orb -->
            <div class="flex-shrink-0 mt-0.5">
              <EnergyOrb cost={displayUpgCost} size="sm" character={character} />
            </div>
            <div class="text-sm text-green-100 leading-relaxed" set:html={upgradedEffect.replace(/\*\*([^*]+)\*\*/g, '<span class="text-green-300 font-bold">$1</span>')} />
          </div>
        </div>
      </div>
    )}
  </div>
</div>
