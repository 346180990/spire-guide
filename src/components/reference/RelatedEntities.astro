---
export interface Props {
  entityType?: string;
  entityName?: string;
  character?: string;
}

const { entityType, entityName, character } = Astro.props;
// This component is a placeholder for future auto-linking of related entities
---

<nav class="mt-8 pt-6 border-t border-border not-prose" aria-label="Related content">
  <h2 class="text-lg font-bold mb-3">Related Content</h2>
  <p class="text-text-muted text-sm">
    {character && <>More <strong>{character}</strong> {entityType || 'cards'} and related guides coming soon.</>}
    {!character && <>Related guides and cross-references coming soon.</>}
  </p>
</nav>
