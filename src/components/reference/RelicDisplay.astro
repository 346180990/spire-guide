---
import EntityBadge from './EntityBadge.astro';

export interface Props {
  name: string;
  rarity: string;
  character?: string;
  image?: string;
}

const { name, rarity, character, image } = Astro.props;
const game = 'slay-the-spire-2';
---

<div class="bg-surface border border-border rounded-xl overflow-hidden mb-6 not-prose">
  {image && (
    <div class="h-48 flex items-center justify-center bg-surface-dark">
      <img
        src={image}
        alt={name}
        width="200"
        height="192"
        class="w-auto h-full object-contain"
        onerror={`this.parentElement.classList.add('hidden');`}
      />
    </div>
  )}
  <div class="p-6">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-3">
      <h1 class="text-2xl md:text-3xl font-extrabold text-text">{name}</h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <EntityBadge label={rarity} variant="rarity" />
      {character ? (
        <EntityBadge
          label={character}
          variant="character"
          href={`/games/${game}/characters/${character.toLowerCase()}/`}
        />
      ) : (
        <EntityBadge label="Universal" variant="default" />
      )}
    </div>
  </div>
</div>
