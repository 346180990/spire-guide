---
import EntityBadge from './EntityBadge.astro';

export interface Props {
  name: string;
  act?: number;
  hp_range?: string;
  moves?: Array<{ name: string; effect: string; damage?: string }>;
  weakness?: string;
  is_elite?: boolean;
  is_boss?: boolean;
  image?: string;
}

const { name, act, hp_range, moves = [], weakness, is_elite, is_boss, image } = Astro.props;

const enemyType = is_boss ? 'Boss' : is_elite ? 'Elite' : 'Normal';
const difficultyColor = is_boss
  ? 'bg-red-950/40 text-red-300 border-red-800'
  : is_elite
    ? 'bg-orange-950/40 text-orange-300 border-orange-800'
    : 'bg-gray-800/60 text-gray-300 border-gray-700';
---

<div class="bg-surface border border-border rounded-xl overflow-hidden mb-6 not-prose">
  {image && (
    <div class="h-48 md:h-56 flex items-center justify-center bg-surface-dark relative">
      <img
        src={image}
        alt={name}
        width="400"
        height="224"
        class="w-auto h-full object-contain"
        onerror={`this.parentElement.classList.add('hidden');`}
      />
    </div>
  )}

  <div class="p-6">
    <!-- Name + Badges -->
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <h1 class="text-2xl md:text-3xl font-extrabold text-text">{name}</h1>
      <div class="flex flex-wrap gap-2">
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${difficultyColor}`}>
          {enemyType}
        </span>
        {act && <EntityBadge label={`Act ${act}`} variant="default" />}
      </div>
    </div>

    <div class="w-full h-px bg-border mb-4"></div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
      {hp_range && (
        <div class="bg-surface-dark rounded-lg p-3 text-center">
          <div class="text-lg font-bold text-accent-red" style="font-family: var(--font-display);">{hp_range}</div>
          <div class="text-xs text-text-muted mt-0.5">HP Range</div>
        </div>
      )}
      {act && (
        <div class="bg-surface-dark rounded-lg p-3 text-center">
          <div class="text-lg font-bold text-primary" style="font-family: var(--font-display);">Act {act}</div>
          <div class="text-xs text-text-muted mt-0.5">Location</div>
        </div>
      )}
      <div class="bg-surface-dark rounded-lg p-3 text-center">
        <div class="text-lg font-bold text-accent-gold" style="font-family: var(--font-display);">{moves.length}</div>
        <div class="text-xs text-text-muted mt-0.5">Moves</div>
      </div>
    </div>

    <!-- Weakness -->
    {weakness && (
      <div class="bg-red-950/20 border border-red-800/40 rounded-lg p-4 mb-5">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-red-400 text-sm font-bold">🎯 Weakness</span>
        </div>
        <p class="text-red-200 text-sm">{weakness}</p>
      </div>
    )}

    <!-- Move Set -->
    {moves.length > 0 && (
      <div class="mb-4">
        <h3 class="text-sm font-semibold text-text-muted uppercase tracking-wide mb-3">Move Set</h3>
        <div class="space-y-2">
          {moves.map(move => (
            <div class="bg-surface-dark border border-border rounded-lg p-3 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-surface-alt border border-border flex items-center justify-center text-sm font-bold text-text">
                  {move.damage || '—'}
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-text">{move.name}</h4>
                  <p class="text-xs text-text-muted">{move.effect}</p>
                </div>
              </div>
              {move.damage && (
                <span class="text-xs font-bold text-accent-red whitespace-nowrap">
                  ⚔ {move.damage} DMG
                </span>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</div>
