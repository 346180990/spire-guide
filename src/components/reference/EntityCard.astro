---
export interface Props {
  href: string;
  name: string;
  subtitle?: string;
  badges: Array<{ label: string; variant?: string }>;
  excerpt?: string;
  dataAttrs?: Record<string, string>;
  image?: string;
}

const { href, name, subtitle, badges, excerpt, dataAttrs = {}, image } = Astro.props;
---

<a
  href={href}
  class="block bg-surface border border-border rounded-lg overflow-hidden hover:border-primary/30 hover:shadow-sm transition-all no-underline group"
  data-entity-card
  {...Object.fromEntries(Object.entries(dataAttrs).map(([k, v]) => [`data-${k}`, v]))}
>
  {image && (
    <div class="h-32 overflow-hidden bg-surface-dark relative">
      <img
        src={image}
        alt={name}
        width="300"
        height="128"
        loading="lazy"
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
        onerror={`this.parentElement.classList.add('hidden');`}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface/60 to-transparent pointer-events-none"></div>
    </div>
  )}
  <div class="p-4">
    <div class="flex items-start justify-between gap-2 mb-2">
      <div>
        <h3 class="font-semibold text-text group-hover:text-primary transition-colors">{name}</h3>
        {subtitle && <p class="text-xs text-text-muted mt-0.5">{subtitle}</p>}
      </div>
    </div>

    <div class="flex flex-wrap gap-1.5 mb-2">
      {badges.map((badge) => {
        const variantStyles: Record<string, string> = {
          type: 'bg-blue-950/40 text-blue-300 border-blue-800',
          rarity: 'bg-amber-950/40 text-amber-300 border-amber-800',
          character: 'bg-purple-950/40 text-purple-300 border-purple-800',
          energy: 'bg-green-950/40 text-green-300 border-green-800',
          default: 'bg-surface-alt text-text-muted',
        };
        const cls = variantStyles[badge.variant || 'default'] || variantStyles.default;
        return <span class={`text-xs font-medium px-2 py-0.5 rounded-full border ${cls}`}>{badge.label}</span>;
      })}
    </div>

    {excerpt && <p class="text-sm text-text-muted line-clamp-2">{excerpt}</p>}
  </div>
</a>
