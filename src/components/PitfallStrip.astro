---
// PitfallStrip — Horizontal warning card strip for common mistakes
// Severity color coding: critical=red, high=orange, medium=yellow

interface Pitfall {
  title: string;
  severity: 'critical' | 'high' | 'medium';
  tip: string;
}

interface Props {
  pitfalls: Pitfall[];
  class?: string;
}

const { pitfalls, class: className } = Astro.props;

const severityConfig: Record<string, { border: string; bg: string; text: string; badge: string }> = {
  critical: {
    border: 'border-l-red-500',
    bg: 'bg-red-950/20',
    text: 'text-red-300',
    badge: 'bg-red-500/20 text-red-400 border-red-500/30',
  },
  high: {
    border: 'border-l-orange-500',
    bg: 'bg-orange-950/20',
    text: 'text-orange-300',
    badge: 'bg-orange-500/20 text-orange-400 border-orange-500/30',
  },
  medium: {
    border: 'border-l-yellow-500',
    bg: 'bg-yellow-950/20',
    text: 'text-yellow-300',
    badge: 'bg-yellow-500/20 text-yellow-400 border-yellow-500/30',
  },
};
---

{
  pitfalls.length > 0 && (
    <section class={`not-prose ${className || ''}`}>
      <h2 class="text-xl font-bold mb-4">Common Pitfalls</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {pitfalls.map((p) => {
          const config = severityConfig[p.severity] || severityConfig.medium;
          return (
            <div class={`${config.bg} border border-border border-l-4 ${config.border} rounded-lg p-4 flex flex-col gap-2`}>
              <div class="flex items-center gap-2">
                <h4 class="font-semibold text-sm text-text">{p.title}</h4>
                <span class={`text-[10px] font-semibold px-1.5 py-0.5 rounded border ml-auto flex-shrink-0 ${config.badge}`}>
                  {p.severity}
                </span>
              </div>
              <p class="text-xs text-text-muted leading-relaxed">{p.tip}</p>
            </div>
          );
        })}
      </div>
    </section>
  )
}
