---
// RarityIcon.astro — SVG icons for rarity tiers with optional glow

export interface Props {
  rarity: string;
  size?: 'sm' | 'md' | 'lg';
  withGlow?: boolean;
}

const { rarity, size = 'md', withGlow = false } = Astro.props;

const sizeMap: Record<string, string> = {
  sm: 'w-3 h-3',
  md: 'w-4 h-4',
  lg: 'w-6 h-6',
};

const glowColors: Record<string, string> = {
  Common: 'rgba(156, 163, 175, 0.3)',
  Uncommon: 'rgba(74, 222, 128, 0.4)',
  Rare: 'rgba(96, 165, 250, 0.5)',
  Boss: 'rgba(251, 146, 60, 0.5)',
  Starter: 'rgba(167, 139, 250, 0.4)',
  Special: 'rgba(244, 114, 182, 0.5)',
  Event: 'rgba(156, 163, 175, 0.3)',
  Shop: 'rgba(156, 163, 175, 0.3)',
  Token: 'rgba(156, 163, 175, 0.3)',
  Curse: 'rgba(156, 163, 175, 0.3)',
};

const rarityDisplayNames: Record<string, string> = {
  Common: 'Common rarity',
  Uncommon: 'Uncommon rarity',
  Rare: 'Rare rarity',
  Boss: 'Boss rarity',
  Starter: 'Starter rarity',
  Special: 'Special rarity',
  Event: 'Event rarity',
  Shop: 'Shop rarity',
  Token: 'Token rarity',
  Curse: 'Curse rarity',
};

const sizeClass = sizeMap[size] || sizeMap.md;
const glow = withGlow ? (glowColors[rarity] || 'transparent') : 'transparent';
const fillColor = rarity === 'Common' ? 'none' : 'currentColor';
const strokeColor = rarity === 'Common' ? 'currentColor' : 'none';

// Diamond/rhombus shape for rarity
function rarityPath(r: string): string {
  switch (r) {
    case 'Boss':
      // Distinctive hexagon for boss
      return '<path d="M12 2l4 4v4l-4 4-4-4V6l4-4z" fill="currentColor" stroke="none"/>';
    case 'Rare':
      // Filled diamond
      return '<path d="M12 2l10 10-10 10L2 12 12 2z" fill="currentColor" stroke="none"/>';
    case 'Uncommon':
      // Diamond outline
      return '<path d="M12 2l10 10-10 10L2 12 12 2z" fill="none" stroke="currentColor" stroke-width="2"/>';
    case 'Starter':
      // Small circle
      return '<circle cx="12" cy="12" r="8" fill="currentColor" stroke="none"/>';
    case 'Special':
      // Star shape
      return '<path d="M12 2l2 7h7l-5.5 4.5 2 7L12 16l-5.5 4.5 2-7L3 9h7l2-7z" fill="currentColor" stroke="none"/>';
    default:
      // Small circle (Common)
      return '<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/>';
  }
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={sizeClass}
  aria-label={rarityDisplayNames[rarity] || `${rarity} rarity`}
  role="img"
  style={withGlow ? `filter: drop-shadow(0 0 4px ${glow});` : ''}
>
  <Fragment set:html={rarityPath(rarity)} />
</svg>
