---
// CardTypeIcon.astro — SVG icons for card types
// Types: Attack, Skill, Power, Status, Curse

export interface Props {
  type: string;
  size?: 'sm' | 'md' | 'lg';
}

const { type, size = 'md' } = Astro.props;

const sizeMap: Record<string, string> = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-8 h-8',
};

const sizeClass = sizeMap[size] || sizeMap.md;

function iconPath(t: string): string {
  switch (t) {
    case 'Attack':
      // Crossed swords
      return '<path d="M14.5 17.5L3 6V3h3l11.5 11.5M9 3l3 3M3 21l3-3m0 0l-3 3m3-3l3 3" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 3l-3 3M10.5 13.5L3 21" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/>';
    case 'Skill':
      // Shield/defense
      return '<path d="M12 2L3 7v5c0 5.5 4 10.5 9 12 5-1.5 9-6.5 9-12V7l-9-5z" stroke="currentColor" fill="none" stroke-width="2" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
    case 'Power':
      // Star/burst
      return '<path d="M12 2l2.4 7.4H22l-6 4.8 2.3 7.2L12 17l-6.3 4.4 2.3-7.2-6-4.8h7.6L12 2z" stroke="currentColor" fill="none" stroke-width="2" stroke-linejoin="round"/>';
    case 'Status':
      // Skull/warning
      return '<circle cx="12" cy="12" r="10" stroke="currentColor" fill="none" stroke-width="2"/><path d="M8 15c2-3 6-3 8 0" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/><line x1="12" y1="7" x2="12" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>';
    case 'Curse':
      // Mystic eye/symbol
      return '<path d="M12 4C8 4 4 8 2 12c2 4 6 8 10 8s8-4 10-8c-2-4-6-8-10-8z" stroke="currentColor" fill="none" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" fill="none" stroke-width="2"/><path d="M2 2l20 20" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>';
    default:
      // Generic card icon
      return '<rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" fill="none" stroke-width="2"/><line x1="8" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="8" y1="14" x2="14" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>';
  }
}

const typeDisplayNames: Record<string, string> = {
  Attack: 'Attack card',
  Skill: 'Skill card',
  Power: 'Power card',
  Status: 'Status card',
  Curse: 'Curse card',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={sizeClass}
  fill="none"
  aria-label={typeDisplayNames[type] || `${type} card`}
  role="img"
>
  <Fragment set:html={iconPath(type)} />
</svg>
