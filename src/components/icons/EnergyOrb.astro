---
// EnergyOrb.astro — Circular SVG energy cost indicator

export interface Props {
  cost: number | string;
  size?: 'sm' | 'md' | 'lg';
  character?: string;
}

const { cost, size = 'md', character = 'Colorless' } = Astro.props;

const sizeMap: Record<string, { orb: string; text: string; cx: number; cy: number; r: number }> = {
  sm: { orb: 'w-6 h-6', text: 'text-xs', cx: 12, cy: 12, r: 10 },
  md: { orb: 'w-8 h-8', text: 'text-sm', cx: 14, cy: 14, r: 12 },
  lg: { orb: 'w-12 h-12', text: 'text-lg', cx: 20, cy: 20, r: 17 },
};

// Character-based orb color mapping
const characterColors: Record<string, { fill: string; stroke: string }> = {
  Ironclad: { fill: '#7f1d1d', stroke: '#ef4444' },
  Silent: { fill: '#14532d', stroke: '#4ade80' },
  Defect: { fill: '#1e3a5f', stroke: '#60a5fa' },
  Regent: { fill: '#713f12', stroke: '#fbbf24' },
  Necrobinder: { fill: '#3b0764', stroke: '#a78bfa' },
  Colorless: { fill: '#1f2937', stroke: '#9ca3af' },
};

const dims = sizeMap[size] || sizeMap.md;
const colors = characterColors[character] || characterColors.Colorless;
const displayCost = String(cost);

// Smaller font for larger numbers
const fontClass = displayCost.length > 1
  ? (size === 'lg' ? 'text-sm' : size === 'md' ? 'text-xs' : 'text-[8px]')
  : dims.text;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${dims.cx * 2} ${dims.cy * 2}`}
  class={dims.orb}
  aria-label={`${displayCost} energy cost`}
  role="img"
>
  <circle
    cx={dims.cx}
    cy={dims.cy}
    r={dims.r}
    fill={colors.fill}
    stroke={colors.stroke}
    stroke-width="2"
  />
  <text
    x={dims.cx}
    y={dims.cy}
    text-anchor="middle"
    dominant-baseline="central"
    class={`${fontClass} font-bold`}
    fill="#e8e6e3"
    font-family="'Inter', ui-sans-serif, system-ui, sans-serif"
  >{displayCost}</text>
</svg>
