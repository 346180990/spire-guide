---
// MechanicIcon.astro — SVG icons for common game mechanic keywords

export interface Props {
  mechanic: string;
  size?: 'sm' | 'md' | 'lg';
}

const { mechanic, size = 'md' } = Astro.props;

const sizeMap: Record<string, string> = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-8 h-8',
};

const sizeClass = sizeMap[size] || sizeMap.md;

function iconPath(m: string): string {
  const lowered = m.toLowerCase();
  if (lowered.includes('strength') || lowered.includes('str')) {
    // Flexed arm / fist
    return '<path d="M8 21V11m0 0l2-4h4l2 4v10M8 11H6a2 2 0 00-2 2v6a2 2 0 002 2h2" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 11h2a2 2 0 012 2v6a2 2 0 01-2 2h-2" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
  }
  if (lowered.includes('block') || lowered.includes('armor') || lowered.includes('plated')) {
    // Shield
    return '<path d="M12 2L3 7v5c0 5.5 4 10.5 9 12 5-1.5 9-6.5 9-12V7l-9-5z" stroke="currentColor" fill="none" stroke-width="2" stroke-linejoin="round"/>';
  }
  if (lowered.includes('poison')) {
    // Drop/flask
    return '<path d="M12 2L8 10c-1 3 0 7 4 10 4-3 5-7 4-10L12 2z" stroke="currentColor" fill="none" stroke-width="2" stroke-linejoin="round"/><path d="M12 14v6" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/>';
  }
  if (lowered.includes('vulnerable') || lowered.includes('weaken')) {
    // Broken/crack
    return '<circle cx="12" cy="12" r="10" stroke="currentColor" fill="none" stroke-width="2"/><path d="M8 8l8 8M12 2v4m0 12v4M2 12h4m12 0h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>';
  }
  if (lowered.includes('intangible') || lowered.includes('dodge') || lowered.includes('evade')) {
    // Ghost/wisp
    return '<path d="M12 2C8 2 4 6 3 12c1 6 5 10 9 10 3 0 5-2 7-5 2-3 4-3 3 0-1 4-3 7-7 7" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/><circle cx="10" cy="9" r="1.5" fill="currentColor"/><circle cx="15" cy="9" r="1.5" fill="currentColor"/>';
  }
  if (lowered.includes('ritual') || lowered.includes('ritual')) {
    // Pentagram/circle
    return '<circle cx="12" cy="12" r="10" stroke="currentColor" fill="none" stroke-width="2"/><path d="M12 2l2 7h7l-5.5 4.5 2 7L12 16l-5.5 4.5 2-7L3 9h7l2-7z" stroke="currentColor" fill="none" stroke-width="1" opacity="0.6"/>';
  }
  if (lowered.includes('retain') || lowered.includes('hold')) {
    // Hand holding
    return '<path d="M18 11V7a2 2 0 00-4 0v1M6 11V7a2 2 0 014 0v4m-4 3l2 8h10l2-8" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
  }
  // Default: gear/cog for generic mechanics
  return '<circle cx="12" cy="12" r="3" stroke="currentColor" fill="none" stroke-width="2"/><circle cx="12" cy="12" r="8" stroke="currentColor" fill="none" stroke-width="1.5" stroke-dasharray="4 3"/>';
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={sizeClass}
  fill="none"
  aria-label={`${mechanic} mechanic`}
  role="img"
>
  <Fragment set:html={iconPath(mechanic)} />
</svg>
