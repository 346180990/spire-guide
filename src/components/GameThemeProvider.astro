---
// GameThemeProvider.astro — Applies CSS custom property overrides from game metadata colorScheme
// Falls back to global theme defaults when no colorScheme is configured.

export interface Props {
  colorScheme?: {
    primary?: string | undefined;
    surface?: string | undefined;
    accent?: string | undefined;
  } | undefined;
}

const { colorScheme } = Astro.props;

// Build style object only for provided values
const styleOverrides: Record<string, string> = {};
if (colorScheme?.primary) {
  styleOverrides['--color-primary'] = colorScheme.primary;
}
if (colorScheme?.surface) {
  styleOverrides['--color-surface'] = colorScheme.surface;
}
if (colorScheme?.accent) {
  styleOverrides['--color-accent-red'] = colorScheme.accent;
}
---

<div style={Object.keys(styleOverrides).length > 0 ? styleOverrides : undefined}>
  <slot />
</div>
