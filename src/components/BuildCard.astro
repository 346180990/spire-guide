---
import { getCollection } from 'astro:content';

interface Props {
  name: string;
  character?: string;
  difficulty?: 'beginner' | 'intermediate' | 'advanced' | 'expert';
  coreCards: string[];
  keyRelics?: string[];
  strategy: string;
  class?: string;
}

const { name, character, difficulty, coreCards, keyRelics, strategy, class: className } = Astro.props;

// Look up card images for core cards
const allCards = await getCollection('cards', ({ data }) => data.game === 'slay-the-spire-2');
const cardImageMap = new Map<string, { image?: string; slug: string }>();
for (const card of allCards) {
  // Index by both name and slug for flexible matching
  cardImageMap.set(card.data.name.toLowerCase(), {
    image: card.data.image,
    slug: card.data.slug,
  });
  cardImageMap.set(card.data.slug.toLowerCase(), {
    image: card.data.image,
    slug: card.data.slug,
  });
}

// Match core cards to images (tries kebab-case slug, then name)
const matchedCards = coreCards.map(name => {
  const key = name.toLowerCase();
  const match = cardImageMap.get(key) || cardImageMap.get(key.replace(/-/g, ' '));
  return { name, image: match?.image, slug: match?.slug };
});

// Look up relic slugs
const allRelics = await getCollection('relics', ({ data }) => data.game === 'slay-the-spire-2');
const relicDataMap = new Map<string, { image?: string; slug: string }>();
for (const relic of allRelics) {
  relicDataMap.set(relic.data.name.toLowerCase(), {
    image: relic.data.image,
    slug: relic.data.slug,
  });
}

const matchedRelics = (keyRelics || []).map(name => {
  const match = relicDataMap.get(name.toLowerCase());
  return { name, image: match?.image, slug: match?.slug };
});

const difficultyColors: Record<string, string> = {
  beginner: 'bg-accent-green/10 text-accent-green border-accent-green/20',
  intermediate: 'bg-accent-gold/10 text-accent-gold border-accent-gold/20',
  advanced: 'bg-orange-100 text-orange-700 border-orange-200',
  expert: 'bg-accent-red/10 text-accent-red border-accent-red/20',
};

const typeIcons: Record<string, string> = {
  Attack: '⚔️',
  Skill: '🛡️',
  Power: '⭐',
};
---

<div class={`bg-surface border border-border rounded-xl p-6 my-6 not-prose ${className || ''}`}>
  <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
    <h3 class="text-xl font-bold text-text">{name}</h3>
    <div class="flex flex-wrap gap-2">
      {difficulty && (
        <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${difficultyColors[difficulty] || ''}`}>
          {difficulty}
        </span>
      )}
      {character && (
        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-surface-alt text-text-muted border border-border">
          {character}
        </span>
      )}
    </div>
  </div>

  <!-- Core Cards Visual Spread -->
  {matchedCards.length > 0 && (
    <div class="mb-5">
      <h4 class="text-sm font-semibold text-text-muted uppercase tracking-wide mb-3">Core Cards</h4>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
        {matchedCards.map(card => (
          <a
            href={card.slug ? `/games/slay-the-spire-2/cards/${card.slug}/` : '#'}
            class="block bg-surface-dark border border-border rounded-lg overflow-hidden hover:border-primary/40 hover:shadow-sm transition-all no-underline group"
          >
            {card.image ? (
              <div class="h-28 bg-surface-dark relative flex items-center justify-center p-1">
                <img
                  src={card.image}
                  alt={card.name}
                  width="200"
                  height="112"
                  loading="lazy"
                  class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-200"
                  onerror={`this.style.display='none';this.parentElement.innerHTML='<div class=\\'flex items-center justify-center h-full\\'><span class=\\'text-text-muted text-xs font-medium\\'>${card.name}</span></div>';`}
                />
              </div>
            ) : (
              <div class="h-28 bg-surface-dark flex items-center justify-center">
                <span class="text-text-muted text-xs font-medium">{card.name}</span>
              </div>
            )}
            <div class="p-2">
              <p class="text-xs font-medium text-text group-hover:text-primary transition-colors text-center truncate">{card.name}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Key Relics -->
  {matchedRelics.length > 0 && (
    <div class="mb-5">
      <h4 class="text-sm font-semibold text-text-muted uppercase tracking-wide mb-3">Key Relics</h4>
      <div class="flex flex-wrap gap-1.5">
        {matchedRelics.map(relic => (
          <a
            href={relic.slug ? `/games/slay-the-spire-2/relics/${relic.slug}/` : '#'}
            class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1.5 rounded-lg bg-accent-gold/8 text-accent-gold border border-accent-gold/15 hover:bg-accent-gold/15 transition-colors no-underline"
          >
            {relic.image && (
              <img
                src={relic.image}
                alt={relic.name}
                width="24"
                height="24"
                loading="lazy"
                class="w-4 h-4 object-contain"
                onerror="this.remove();"
              />
            )}
            {relic.name}
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Strategy -->
  {strategy && (
    <div>
      <h4 class="text-sm font-semibold text-text-muted uppercase tracking-wide mb-2">Strategy</h4>
      <p class="text-sm text-text leading-relaxed">{strategy}</p>
    </div>
  )}
</div>
