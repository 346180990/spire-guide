---
interface TierEntry {
  name: string;
  description?: string;
  icon?: string;
}

interface TierGroup {
  tier: 'S' | 'A' | 'B' | 'C' | 'D' | 'F';
  label?: string;
  items: TierEntry[];
}

interface Props {
  title?: string;
  tiers: TierGroup[];
  class?: string;
}

const { title, tiers, class: className } = Astro.props;

const tierStyles: Record<string, { bg: string; border: string; text: string; badge: string }> = {
  S: { bg: 'bg-tier-s/5', border: 'border-tier-s/30', text: 'text-tier-s', badge: 'bg-tier-s text-white' },
  A: { bg: 'bg-tier-a/5', border: 'border-tier-a/30', text: 'text-tier-a', badge: 'bg-tier-a text-white' },
  B: { bg: 'bg-tier-b/5', border: 'border-tier-b/30', text: 'text-tier-b', badge: 'bg-tier-b text-white' },
  C: { bg: 'bg-tier-c/5', border: 'border-tier-c/30', text: 'text-tier-c', badge: 'bg-tier-c text-white' },
  D: { bg: 'bg-tier-d/5', border: 'border-tier-d/30', text: 'text-tier-d', badge: 'bg-tier-d text-white' },
  F: { bg: 'bg-tier-d/5', border: 'border-tier-d/30', text: 'text-tier-d', badge: 'bg-tier-d text-white' },
};
---

<div class={`not-prose my-6 ${className || ''}`}>
  {title && <h3 class="text-xl font-bold mb-4">{title}</h3>}

  <div class="space-y-3">
    {tiers.map(group => {
      const style = tierStyles[group.tier] || tierStyles.B;
      return (
        <div class={`rounded-lg border ${style.border} ${style.bg} overflow-hidden`}>
          <div class="flex items-start gap-4 p-4">
            <div class={`flex-shrink-0 w-10 h-10 rounded-lg ${style.badge} flex items-center justify-center font-extrabold text-lg`}>
              {group.tier}
            </div>
            <div class="flex-1 min-w-0">
              {group.label && (
                <p class="text-xs font-semibold text-text-muted uppercase tracking-wide mb-2">{group.label}</p>
              )}
              <div class="space-y-2">
                {group.items.map(item => (
                  <div>
                    <div class="flex items-center gap-2">
                      {item.icon && <span class="text-sm">{item.icon}</span>}
                      <span class="font-semibold text-sm text-text">{item.name}</span>
                    </div>
                    {item.description && (
                      <p class="text-xs text-text-muted mt-0.5 ml-6">{item.description}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
