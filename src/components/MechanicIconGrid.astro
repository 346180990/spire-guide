---
// MechanicIconGrid — Adaptive icon grid for character core mechanics
// Clean card layout with icon, name, and one-line tip

interface MechanicItem {
  id: string;
  icon: string;
  name: string;
  passive: string;
  evoke?: string;
  tip: string;
}

interface Props {
  mechanics: MechanicItem[];
  class?: string;
}

const { mechanics, class: className } = Astro.props;

const accentColors: Record<string, string> = {
  lightning: 'text-yellow-400',
  frost: 'text-cyan-400',
  dark: 'text-purple-400',
  plasma: 'text-teal-400',
  strength: 'text-red-400',
  poison: 'text-green-400',
  shiv: 'text-gray-300',
  discard: 'text-amber-400',
  exhaust: 'text-orange-400',
  'self-damage': 'text-rose-400',
  healing: 'text-emerald-400',
  command: 'text-amber-400',
  ally: 'text-blue-400',
  legacy: 'text-yellow-400',
  doom: 'text-purple-400',
  soul: 'text-cyan-300',
  summon: 'text-green-400',
  curse: 'text-fuchsia-400',
  sacrifice: 'text-red-500',
};

const defaultAccent = 'text-primary';
---

{
  mechanics.length > 0 && (
    <section class={`not-prose ${className || ''}`}>
      <h2 class="text-xl font-bold mb-4">Core Mechanics</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {mechanics.map((m) => {
          const accent = accentColors[m.id] || defaultAccent;
          return (
            <div class="bg-surface border border-border rounded-xl p-5 flex flex-col gap-3 hover:border-primary/20 transition-colors">
              <div class="flex items-center gap-3">
                <span class={`text-2xl flex-shrink-0 ${accent}`} role="img" aria-label={m.name}>{m.icon}</span>
                <div>
                  <h3 class="font-bold text-text text-sm">{m.name}</h3>
                  <p class="text-xs text-text-muted">{m.passive}</p>
                </div>
              </div>
              <p class="text-xs text-text-muted leading-relaxed">{m.tip}</p>
            </div>
          );
        })}
      </div>
    </section>
  )
}
