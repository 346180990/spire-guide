---
// StartingHand — Visual "hand of cards" for character starting deck
// Shows actual card images loaded from the cards collection

interface StartingDeckCard {
  name: string;
  slug?: string;
  count: number;
  upgradePriority?: number;
}

interface CardImageData {
  image?: string;
  slug: string;
}

interface Props {
  cards: StartingDeckCard[];
  gameSlug: string;
  characterName: string;
  cardLookup: Map<string, CardImageData>;
  class?: string;
}

const { cards, gameSlug, characterName, cardLookup, class: className } = Astro.props;

function findCardData(name: string, slug: string | undefined): CardImageData | undefined {
  // Try slug first, then name, then kebab→space conversion
  if (slug) {
    const match = cardLookup.get(slug.toLowerCase());
    if (match) return match;
  }
  const byName = cardLookup.get(name.toLowerCase());
  if (byName) return byName;
  // Try converting kebab-case to space-separated
  const converted = cardLookup.get(name.toLowerCase().replace(/-/g, ' '));
  if (converted) return converted;
  return undefined;
}

function getUpgradeBadge(priority?: number): { label: string; style: string } | null {
  if (!priority) return null;
  if (priority === 1) return { label: 'Upgrade First', style: 'bg-accent-green/15 text-accent-green border-accent-green/30' };
  if (priority === 2) return { label: 'High Priority', style: 'bg-accent-gold/15 text-accent-gold border-accent-gold/30' };
  return null;
}
---

{
  cards.length > 0 && (
    <section class={`not-prose ${className || ''}`}>
      <h2 class="text-xl font-bold mb-4">Starting Deck</h2>
      <p class="text-sm text-text-muted mb-4">
        {characterName} begins each run with these {cards.length} card types
        ({cards.reduce((sum, c) => sum + c.count, 0)} total cards).
        Smart early picks and upgrades depend on knowing your starting deck.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
        {cards.map((card) => {
          const badge = getUpgradeBadge(card.upgradePriority);
          const cardData = findCardData(card.name, card.slug);
          const href = cardData?.slug ? `/games/${gameSlug}/cards/${cardData.slug}/` : '#';
          const hasLink = !!cardData?.slug;
          return (
            <a
              href={href}
              class={`block bg-surface border border-border rounded-lg overflow-hidden hover:border-primary/30 hover:shadow-md transition-all no-underline group ${
                !hasLink ? 'pointer-events-none opacity-60' : ''
              }`}
            >
              <div class="h-28 bg-surface-dark relative flex items-center justify-center p-1">
                {cardData?.image ? (
                  <img
                    src={cardData.image}
                    alt={card.name}
                    width="200"
                    height="112"
                    loading="lazy"
                    class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-300"
                    onerror={`this.style.display='none';this.parentElement.innerHTML='<span class="text-text-muted text-xs font-medium">${card.name}</span>';`}
                  />
                ) : (
                  <span class="text-text-muted text-xs font-medium">{card.name}</span>
                )}
              </div>
              <div class="p-2.5">
                <div class="flex items-center justify-between gap-1 mb-1">
                  <h4 class="text-sm font-semibold text-text group-hover:text-primary transition-colors truncate">
                    {card.name}
                  </h4>
                  <span class="text-xs font-medium text-text-muted bg-surface-alt px-1.5 py-0.5 rounded border border-border">
                    x{card.count}
                  </span>
                </div>
                {badge && (
                  <span class={`inline-block text-[10px] font-semibold px-1.5 py-0.5 rounded border ${badge.style} mt-0.5`}>
                    {badge.label}
                  </span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )
}
