---
// CharacterDashboardLayout — Unified dashboard layout for all character pages
// Reads character YAML data, renders all visual dashboard sections
// Handles Colorless special case (skips inapplicable sections)
// Preserves JSON-LD, breadcrumbs, ads, and card pool from existing pages

import MainLayout from './MainLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import MechanicIconGrid from '../components/MechanicIconGrid.astro';
import StartingHand from '../components/StartingHand.astro';
import StrategyTimeline from '../components/StrategyTimeline.astro';
import PitfallStrip from '../components/PitfallStrip.astro';
import BuildCard from '../components/BuildCard.astro';
import TierList from '../components/TierList.astro';
import type { CharacterDashboard } from '../content/schemas/character-dashboard';
import type { CollectionEntry } from 'astro:content';

interface GameInfo {
  name: string;
  slug: string;
}

interface Props {
  character: CharacterDashboard;
  game: GameInfo;
  // Existing page data preserved from current character page
  allCards: CollectionEntry<'cards'>[];
  starterCards: CollectionEntry<'cards'>[];
  cardPool: CollectionEntry<'cards'>[];
  cardsByRarity: Record<string, CollectionEntry<'cards'>[]>;
  sortedRarities: string[];
  characterGuides: CollectionEntry<'guides'>[];
  // Optional MDX slot content
  customContent?: string;
}

const {
  character,
  game,
  allCards,
  starterCards,
  cardPool,
  cardsByRarity,
  sortedRarities,
  characterGuides,
} = Astro.props;

// Build card image lookup map (indexed by name + slug)
const cardLookupMap = new Map<string, { image?: string; slug: string }>();
for (const card of allCards) {
  cardLookupMap.set(card.data.name.toLowerCase(), { image: card.data.image, slug: card.data.slug });
  cardLookupMap.set(card.data.slug.toLowerCase(), { image: card.data.image, slug: card.data.slug });
}

const siteUrl = Astro.site?.href || 'https://spireguide.com';
const pageUrl = `/games/${game.slug}/characters/${character.slug}/`;
const canonicalURL = new URL(pageUrl, siteUrl).href;

// ─── Helpers ───────────────────────────────────────────────────────────────

const difficultyColors: Record<string, string> = {
  beginner: 'bg-accent-green/10 text-accent-green border-accent-green/20',
  intermediate: 'bg-accent-gold/10 text-accent-gold border-accent-gold/20',
  advanced: 'bg-orange-950/30 text-orange-400 border-orange-500/30',
  expert: 'bg-accent-red/10 text-accent-red border-accent-red/20',
};

const rarityColors: Record<string, string> = {
  Common: 'bg-gray-800/60 text-gray-300 border-gray-700',
  Uncommon: 'bg-green-950/40 text-green-300 border-green-800',
  Rare: 'bg-blue-950/40 text-blue-300 border-blue-800',
  Starter: 'bg-purple-950/40 text-purple-300 border-purple-800',
  Boss: 'bg-orange-950/40 text-orange-300 border-orange-800',
  Special: 'bg-pink-950/40 text-pink-300 border-pink-800',
};

const typeColors: Record<string, string> = {
  Attack: 'bg-red-950/40 text-red-300 border-red-800',
  Skill: 'bg-blue-950/40 text-blue-300 border-blue-800',
  Power: 'bg-yellow-950/40 text-yellow-300 border-yellow-800',
  Status: 'bg-gray-800/60 text-gray-400 border-gray-700',
  Curse: 'bg-purple-950/60 text-purple-400 border-purple-800',
};

// Helper functions for QuickRef info (now inlined in hero header)
function renderDifficultyDots(rating: number): string {
  const filled = '●';
  const empty = '○';
  return filled.repeat(Math.min(rating, 5)) + empty.repeat(Math.max(0, 5 - rating));
}

const difficultyLabels: Record<number, string> = {
  1: 'Very Easy',
  2: 'Easy',
  3: 'Moderate',
  4: 'Hard',
  5: 'Very Hard',
};

const guideTypeLabels: Record<string, string> = {
  'build': 'Build Guide',
  'tier-list': 'Tier List',
  'beginner': 'Beginner Guide',
  'advanced': 'Advanced Guide',
  'character-overview': 'Character Overview',
  'roadmap': 'Roadmap',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

// ─── Breadcrumbs ───────────────────────────────────────────────────────────

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: game.name, href: `/games/${game.slug}/` },
  { label: character.name },
];
---

<MainLayout
  title={`${character.name} — ${game.name} Character Guide | Spire Guide`}
  description={`${character.name}: ${character.role || character.playstyle}. ${character.tagline} Complete card pool, starting deck, and strategy guides.`}
  canonicalURL={canonicalURL}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- ========================================================== -->
    <!-- Breadcrumbs                                                    -->
    <!-- ========================================================== -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-1 text-text-muted">
        {breadcrumbs.map((crumb, i) => (
          <li class="flex items-center gap-1">
            {i > 0 && <span class="mx-1" aria-hidden="true">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="text-text-muted hover:text-primary no-underline">
                {crumb.label}
              </a>
            ) : (
              <span class="text-text font-medium truncate max-w-[200px]">{crumb.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <!-- ========================================================== -->
    <!-- JSON-LD Structured Data                                        -->
    <!-- ========================================================== -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: crumb.href
          ? { '@id': new URL(crumb.href, siteUrl).href, name: crumb.label }
          : { name: crumb.label },
      })),
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: `${character.name} Character Guide — ${game.name}`,
      description: character.tagline,
      author: {
        '@type': 'Person',
        name: 'Spire Guide Editor',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Spire Guide',
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL,
      },
    })} />

    <!-- ========================================================== -->
    <!-- Hero Badge — Character Header                                  -->
    <!-- ========================================================== -->
    <header class="mb-10 flex flex-col md:flex-row gap-6 items-start">
      {character.characterImage && (
        <div class="flex-shrink-0 w-full md:w-56 h-48 md:h-56 rounded-xl overflow-hidden bg-surface-dark border border-border">
          <img
            src={character.characterImage}
            alt={character.name}
            width="400"
            height="300"
            class="w-full h-full object-cover"
            onerror={`this.parentElement.classList.add('hidden');`}
          />
        </div>
      )}
      <div class="flex-1">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <h1 class="text-3xl md:text-4xl font-extrabold">{character.name}</h1>
          <span class={`text-xs font-semibold px-3 py-1 rounded-full border ${difficultyColors[character.difficulty] || ''}`}>
            {character.difficulty}
          </span>
        </div>
        {character.role && (
          <p class="text-lg font-medium text-primary mb-1">
            {character.role}
            {character.quickRef?.difficultyRating && (
              <span class="text-sm font-normal text-text-muted ml-3">
                {renderDifficultyDots(character.quickRef.difficultyRating)}
                <span class="ml-1">{difficultyLabels[character.quickRef.difficultyRating] || ''}</span>
              </span>
            )}
          </p>
        )}
        <p class="text-text-muted max-w-2xl text-lg leading-relaxed">{character.tagline}</p>
        <p class="text-xs text-text-muted mt-2">
          <span class="uppercase tracking-wide">Playstyle:</span> <span class="text-text font-medium">{character.playstyle}</span>
          {character.quickRef?.paceLabel && (
            <span class="ml-2 text-text-muted">· {character.quickRef.paceLabel}</span>
          )}
        </p>
      </div>
    </header>

    <!-- ========================================================== -->
    <!-- Stats Row                                                      -->
    <!-- ========================================================== -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
      <div class="bg-surface border border-border rounded-xl p-4 text-center">
        <div class="text-2xl font-extrabold text-primary" style="font-family: var(--font-display);">{allCards.length}</div>
        <div class="text-xs text-text-muted mt-1">Cards in Pool</div>
      </div>
      <div class="bg-surface border border-border rounded-xl p-4 text-center">
        <div class="text-2xl font-extrabold text-accent-green" style="font-family: var(--font-display);">{starterCards.length}</div>
        <div class="text-xs text-text-muted mt-1">Starting Deck</div>
      </div>
      <div class="bg-surface border border-border rounded-xl p-4 text-center">
        <div class="text-2xl font-extrabold text-accent-gold" style="font-family: var(--font-display);">{characterGuides.length}</div>
        <div class="text-xs text-text-muted mt-1">Guides</div>
      </div>
      <div class="bg-surface border border-border rounded-xl p-4 text-center">
        <div class="text-2xl font-extrabold text-text-muted" style="font-family: var(--font-display);">
          {cardPool.filter((c: CollectionEntry<'cards'>) => c.data.rarity === 'Rare').length}
        </div>
        <div class="text-xs text-text-muted mt-1">Rare Cards</div>
      </div>
    </div>

    <!-- ========================================================== -->
    <!-- Dashboard Sections (conditional on isColorless)                -->
    <!-- ========================================================== -->

    {!character.isColorless && (
      <>
        {/* Core Mechanics */}
        <div class="mb-10">
          <MechanicIconGrid mechanics={character.mechanics} />
        </div>

        {/* Starting Deck — Below Core Mechanics */}
        {character.startingDeck && (
          <div class="mb-10">
            <StartingHand
              cards={character.startingDeck.cards}
              gameSlug={game.slug}
              characterName={character.name}
              cardLookup={cardLookupMap}
            />
          </div>
        )}

        {/* Strategy Timeline */}
        {character.strategy && (
          <div class="mb-10">
            <StrategyTimeline strategy={character.strategy} />
          </div>
        )}

        {/* Archetypes Grid */}
        {character.archetypes.length > 0 && (
          <div class="mb-10">
            <h2 class="text-xl font-bold mb-4">Archetypes & Builds</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {character.archetypes.map((arch) => (
                <BuildCard
                  name={arch.name}
                  character={character.name}
                  difficulty={arch.difficulty}
                  coreCards={arch.keyCards}
                  keyRelics={arch.keyRelics}
                  strategy={arch.description || ''}
                />
              ))}
            </div>
          </div>
        )}

        {/* Relic Tier List */}
        {character.relicTiers.length > 0 && (
          <div class="mb-10">
            <TierList
              title="Relic Tier List"
              tiers={character.relicTiers.map((t) => ({
                tier: t.tier,
                label: t.label,
                items: t.items,
              }))}
            />
          </div>
        )}
      </>
    )}

    {/* Pitfall Strip — shown for all characters including Colorless */}
    <div class="mb-10">
      <PitfallStrip pitfalls={character.pitfalls} />
    </div>

    {/* Optional MDX Slot */}
    {Astro.slots.default && (
      <div class="mb-10 prose prose-slate max-w-none">
        <slot />
      </div>
    )}

    <!-- ========================================================== -->
    <!-- Strategy Guides Listing                                        -->
    <!-- ========================================================== -->
    <section class="mb-10">
      <h2 class="text-xl font-bold mb-4">
        {character.name} Strategy Guides
        {characterGuides.length > 0 && (
          <span class="text-sm font-normal text-text-muted ml-2">({characterGuides.length})</span>
        )}
      </h2>

      {characterGuides.length === 0 ? (
        <div class="text-center py-12 bg-surface-alt rounded-lg border border-border">
          <p class="text-text-muted text-lg">No guides yet for {character.name}.</p>
          <p class="text-text-light text-sm mt-2">Check back soon or browse other characters.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {characterGuides.map((guide: CollectionEntry<'guides'>) => (
            <a
              href={`/games/${game.slug}/guides/${guide.id}/`}
              class="block bg-surface border border-border rounded-lg p-5 hover:shadow-md hover:border-primary/30 transition-all no-underline"
            >
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs font-medium px-2 py-0.5 rounded bg-surface-alt text-text-muted border border-border">
                  {guideTypeLabels[guide.data.guideType] || guide.data.guideType}
                </span>
                {guide.data.phase && guide.data.phase !== 'research' && (
                  <span class="text-xs font-medium px-2 py-0.5 rounded bg-accent-green/10 text-accent-green border border-accent-green/20">
                    {guide.data.phase === 'verified' ? '✓ Verified' : '★ Authoritative'}
                  </span>
                )}
              </div>
              <h3 class="font-semibold text-text mb-1">{guide.data.title}</h3>
              <p class="text-sm text-text-muted line-clamp-2 mb-2">{guide.data.description}</p>
              <time class="text-xs text-text-light" datetime={(guide.data.updatedDate || guide.data.publishDate).toISOString()}>
                {formatDate(guide.data.updatedDate || guide.data.publishDate)}
              </time>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- After-content ad -->
    <AdSlot slot="after-content" />

    <!-- ========================================================== -->
    <!-- Full Card Pool (collapsible)                                   -->
    <!-- ========================================================== -->
    <section>
      <details class="group">
        <summary class="cursor-pointer text-xl font-bold mb-4 list-none flex items-center gap-2 hover:text-primary transition-colors">
          <span class="group-open:hidden inline-block text-sm text-text-muted">▶</span>
          <span class="group-open:inline-block hidden text-sm text-text-muted">▼</span>
          Card Pool
          <span class="text-sm font-normal text-text-muted">({cardPool.length} cards)</span>
        </summary>
        <p class="text-sm text-text-muted mb-4">
          All {cardPool.length} cards {character.name} can obtain during a run, grouped by rarity.
        </p>

        {sortedRarities.map((rarity: string) => (
          <div class="mb-6">
            <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
              <span class={`text-xs px-2 py-0.5 rounded-full border ${rarityColors[rarity] || ''}`}>{rarity}</span>
              <span class="text-text-muted text-xs">({cardsByRarity[rarity].length} cards)</span>
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2">
              {cardsByRarity[rarity].map((card: CollectionEntry<'cards'>) => (
                <a
                  href={`/games/${game.slug}/cards/${card.data.slug}/`}
                  class="block bg-surface border border-border rounded-lg overflow-hidden hover:border-primary/30 hover:shadow-sm transition-all no-underline group"
                >
                  {card.data.image && (
                    <div class="h-24 bg-surface-dark relative flex items-center justify-center p-1">
                      <img
                        src={card.data.image}
                        alt={card.data.name}
                        width="180"
                        height="96"
                        loading="lazy"
                        class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-300"
                        onerror={`this.parentElement.innerHTML='<span class=\\'text-text-muted text-xs\\'>${card.data.name}</span>';`}
                      />
                    </div>
                  )}
                  <div class="p-2">
                    <div class="flex items-center justify-between gap-1">
                      <h4 class="text-xs font-semibold text-text group-hover:text-primary transition-colors truncate">{card.data.name}</h4>
                      <span class={`text-[10px] font-medium px-1 py-0.5 rounded border ${typeColors[card.data.type] || 'bg-gray-800/60 text-gray-300 border-gray-700'}`}>
                        {card.data.type[0]}
                      </span>
                    </div>
                    {card.data.effect && (
                      <p class="text-[11px] text-text-muted mt-1 line-clamp-1">
                        {card.data.effect.replace(/\*\*/g, '')}
                      </p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}
      </details>

      <noscript>
        <style>
          details.card-pool details { display: block !important; }
        </style>
      </noscript>
    </section>

  </div>
</MainLayout>
