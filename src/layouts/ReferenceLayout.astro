---
import MainLayout from './MainLayout.astro';
import AdSlot from '../components/AdSlot.astro';

export interface Props {
  title: string;
  description: string;
  entityType: string; // 'Card', 'Relic', 'Potion', 'Mechanic', 'Enemy'
  entityName: string;
  gameSlug?: string;
  gameName?: string;
  publishDate?: Date;
}

const {
  title,
  description,
  entityType,
  entityName,
  gameSlug = 'slay-the-spire-2',
  gameName = 'Slay the Spire 2',
  publishDate = new Date(),
} = Astro.props;

const gameUrl = `/games/${gameSlug}/`;
const typeUrl = `/games/${gameSlug}/${entityType.toLowerCase()}s/`;
const siteUrl = Astro.site || 'https://example.com';
const pageUrl = `${siteUrl}games/${gameSlug}/${entityType.toLowerCase()}s/${Astro.params.slug || ''}/`;
---

<MainLayout title={title} description={description} canonicalURL={pageUrl}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-1 text-text-muted">
        <li class="flex items-center gap-1">
          <a href="/" class="text-text-muted hover:text-primary no-underline">Home</a>
        </li>
        <li class="flex items-center gap-1">
          <span class="mx-1" aria-hidden="true">/</span>
          <a href={gameUrl} class="text-text-muted hover:text-primary no-underline">{gameName}</a>
        </li>
        <li class="flex items-center gap-1">
          <span class="mx-1" aria-hidden="true">/</span>
          <a href={typeUrl} class="text-text-muted hover:text-primary no-underline">{entityType}s</a>
        </li>
        <li class="flex items-center gap-1">
          <span class="mx-1" aria-hidden="true">/</span>
          <span class="text-text font-medium truncate max-w-[200px]">{entityName}</span>
        </li>
      </ol>
    </nav>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, item: { '@id': `${siteUrl}`, name: 'Home' } },
        { '@type': 'ListItem', position: 2, item: { '@id': `${siteUrl}games/${gameSlug}/`, name: gameName } },
        { '@type': 'ListItem', position: 3, item: { '@id': `${siteUrl}games/${gameSlug}/${entityType.toLowerCase()}s/`, name: `${entityType}s` } },
        { '@type': 'ListItem', position: 4, item: { name: entityName } },
      ],
    })} />

    <div class="mb-6">
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full border bg-amber-900/30 text-amber-300 border-amber-700/50">
        Community Research
      </span>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'VideoGame',
      name: entityName,
      description: description,
      gamePlatform: ['PC'],
      applicationCategory: 'Game',
      datePublished: publishDate.toISOString(),
    })} />

    <slot />

    <!-- After-content ad -->
    <AdSlot slot="after-content" />

    <div class="bg-amber-900/20 border border-amber-700/50 rounded-lg p-4 mt-8 text-sm text-amber-300 not-prose">
      <strong>Community Research Phase:</strong> This reference data is compiled from community sources and has not yet been independently verified by our editor. Game data may change with patches.
    </div>
  </article>
</MainLayout>
