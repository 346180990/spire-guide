---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import FilterBar from '../../../../components/reference/FilterBar.astro';
import EntityCard from '../../../../components/reference/EntityCard.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.filter(g => g.data.active).map(g => ({ params: { game: g.data.slug } }));
}

const { game } = Astro.params;
const gameName = 'Slay the Spire 2';
const potions = await getCollection('potions', ({ data }) => data.game === game);

const sorted = potions.sort((a, b) => a.data.name.localeCompare(b.data.name));

const title = `All Potions — Slay the Spire 2 Potion Database | Spire Guide`;
const description = `Complete database of all ${potions.length} potions in Slay the Spire 2. Browse by rarity and character.`;
---

<MainLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <nav class="text-sm text-text-muted mb-4">
        <a href="/" class="hover:text-primary no-underline">Home</a>
        <span class="mx-1">/</span>
        <a href={`/games/${game}/`} class="hover:text-primary no-underline">{gameName}</a>
        <span class="mx-1">/</span>
        <span class="text-text font-medium">Potions</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-2">Slay the Spire 2 Potions</h1>
      <p class="text-text-muted">Browse all <strong>{potions.length}</strong> potions.</p>
    </header>

    <FilterBar
      filterId="potion-filters"
      filters={[{
        id: 'rarity',
        label: 'Rarity',
        options: [
          { label: 'Common', value: 'Common' },
          { label: 'Uncommon', value: 'Uncommon' },
          { label: 'Rare', value: 'Rare' },
          { label: 'Event', value: 'Event' },
        ],
      }]}
    />

    <p id="potion-filters-count" class="text-sm text-text-muted mb-4">{sorted.length} results</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {sorted.map((p) => (
        <EntityCard
          href={`/games/${game}/potions/${p.data.slug}/`}
          name={p.data.name}
          badges={[
            { label: p.data.rarity, variant: 'rarity' },
            ...(p.data.character ? [{ label: p.data.character, variant: 'character' as const }] : []),
          ]}
          excerpt={p.data.effect}
          image={p.data.image}
          dataAttrs={{ rarity: p.data.rarity }}
        />
      ))}
    </div>
  </div>
</MainLayout>
