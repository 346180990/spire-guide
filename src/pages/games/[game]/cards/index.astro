---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import FilterBar from '../../../../components/reference/FilterBar.astro';
import EntityCard from '../../../../components/reference/EntityCard.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.filter(g => g.data.active).map(g => ({ params: { game: g.data.slug } }));
}

const { game } = Astro.params;
const gameName = 'Slay the Spire 2';
const cards = await getCollection('cards', ({ data }) => data.game === game);

// Sort cards by type then name
const sortedCards = cards.sort((a, b) => {
  if (a.data.type !== b.data.type) return a.data.type.localeCompare(b.data.type);
  return a.data.name.localeCompare(b.data.name);
});

const title = `All Cards — Slay the Spire 2 Card Database | Spire Guide`;
const description = `Complete database of all ${cards.length} cards in Slay the Spire 2. Browse by character, type, rarity, and energy cost.`;
---

<MainLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <nav class="text-sm text-text-muted mb-4">
        <a href="/" class="hover:text-primary no-underline">Home</a>
        <span class="mx-1">/</span>
        <a href={`/games/${game}/`} class="hover:text-primary no-underline">{gameName}</a>
        <span class="mx-1">/</span>
        <span class="text-text font-medium">Cards</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-2">Slay the Spire 2 Cards</h1>
      <p class="text-text-muted">
        Browse all <strong>{cards.length}</strong> cards. Click any card for detailed stats, synergies, and build recommendations.
      </p>
    </header>

    <FilterBar
      filterId="card-filters"
      filters={[
        {
          id: 'character',
          label: 'Character',
          options: [
            { label: 'Ironclad', value: 'Ironclad' },
            { label: 'Silent', value: 'Silent' },
            { label: 'Defect', value: 'Defect' },
            { label: 'Regent', value: 'Regent' },
            { label: 'Necrobinder', value: 'Necrobinder' },
            { label: 'Colorless', value: 'Colorless' },
          ],
        },
        {
          id: 'type',
          label: 'Type',
          options: [
            { label: 'Attack', value: 'Attack' },
            { label: 'Skill', value: 'Skill' },
            { label: 'Power', value: 'Power' },
          ],
        },
        {
          id: 'rarity',
          label: 'Rarity',
          options: [
            { label: 'Common', value: 'Common' },
            { label: 'Uncommon', value: 'Uncommon' },
            { label: 'Rare', value: 'Rare' },
            { label: 'Starter', value: 'Starter' },
          ],
        },
      ]}
    />

    <p id="card-filters-count" class="text-sm text-text-muted mb-4">
      {cards.length} results
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {sortedCards.map((card) => (
        <EntityCard
          href={`/games/${game}/cards/${card.data.slug}/`}
          name={card.data.name}
          subtitle={card.data.energy_cost !== undefined ? `${card.data.energy_cost === 'X' ? 'X' : card.data.energy_cost} Energy` : undefined}
          badges={[
            { label: card.data.type, variant: 'type' },
            { label: card.data.rarity, variant: 'rarity' },
            { label: card.data.character, variant: 'character' },
          ]}
          excerpt={card.data.effect}
          image={card.data.image}
          dataAttrs={{
            character: card.data.character,
            type: card.data.type,
            rarity: card.data.rarity,
          }}
        />
      ))}
    </div>
  </div>
</MainLayout>
