---
import { getCollection, getEntry, render } from 'astro:content';
import ReferenceLayout from '../../../../layouts/ReferenceLayout.astro';
import CardFrame from '../../../../components/reference/CardFrame.astro';
import GameThemeProvider from '../../../../components/GameThemeProvider.astro';

export async function getStaticPaths() {
  const cards = await getCollection('cards', ({ data }) => data.game === 'slay-the-spire-2');
  return cards.map((card) => ({
    params: { game: 'slay-the-spire-2', slug: card.data.slug },
    props: { card },
  }));
}

const { card } = Astro.props;
const { Content } = await render(card);

const gameEntry = await getEntry('games', 'slay-the-spire-2');

const title = `${card.data.name} — ${card.data.character} ${card.data.rarity} ${card.data.type} Card | STS2`;
const description = `${card.data.name} is a ${card.data.rarity.toLowerCase()} ${card.data.type.toLowerCase()} card for ${card.data.character} in Slay the Spire 2.${card.data.energy_cost !== undefined ? ` Costs ${card.data.energy_cost} energy.` : ''}`;
---

<GameThemeProvider colorScheme={gameEntry?.data.colorScheme}>
  <ReferenceLayout
    title={title}
    description={description}
    entityType="Card"
    entityName={card.data.name}
  >
    <CardFrame
      name={card.data.name}
      type={card.data.type}
      character={card.data.character}
      rarity={card.data.rarity}
      cost={card.data.energy_cost ?? 0}
      image={card.data.image}
      upgradedCost={card.data.upgraded_energy_cost}
      upgradedEffect={card.data.upgraded_effect}
    >
      <div slot="effect" class="prose prose-slate max-w-none">
        <Content />
      </div>
    </CardFrame>
  </ReferenceLayout>
</GameThemeProvider>
