---
import MainLayout from '../../../../layouts/MainLayout.astro';
import CharacterDashboardLayout from '../../../../layouts/CharacterDashboardLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import GameThemeProvider from '../../../../components/GameThemeProvider.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  const paths: { params: { game: string; character: string } }[] = [];

  for (const game of games) {
    if (!game.data.active) continue;
    for (const character of game.data.characters) {
      paths.push({
        params: { game: game.data.slug, character: character.slug },
      });
    }
  }

  return paths;
}

const { game: gameSlug, character: characterSlug } = Astro.params;

const gameEntry = await getEntry('games', gameSlug!);
if (!gameEntry) {
  return Astro.rewrite('/404');
}

const characterMeta = gameEntry.data.characters.find(ch => ch.slug === characterSlug);
if (!characterMeta) {
  return Astro.rewrite('/404');
}

// Try to load dashboard YAML data
const characterDashboard = await getEntry('characters', characterSlug!);

// Get all cards for this character
const allCards = await getCollection('cards', ({ data }) =>
  data.game === gameSlug && data.character === characterMeta.name
);

// Separate starter deck cards from full card pool
const starterCards = allCards.filter(c => c.data.rarity === 'Starter');
const cardPool = allCards.filter(c => c.data.rarity !== 'Starter');

// Group cards by rarity
const cardsByRarity: Record<string, typeof allCards> = {};
for (const card of cardPool) {
  const rarity = card.data.rarity || 'Special';
  if (!cardsByRarity[rarity]) cardsByRarity[rarity] = [];
  cardsByRarity[rarity].push(card);
}

const rarityOrder = ['Common', 'Uncommon', 'Rare', 'Boss', 'Special'];
const sortedRarities = Object.keys(cardsByRarity).sort(
  (a, b) => rarityOrder.indexOf(a) - rarityOrder.indexOf(b)
);

// Character guides
const allGuides = await getCollection('guides');
const characterGuides = allGuides
  .filter(g => g.data.game === gameSlug && g.data.character === characterMeta.name)
  .sort((a, b) => {
    const dateA = a.data.updatedDate || a.data.publishDate;
    const dateB = b.data.updatedDate || b.data.publishDate;
    return dateB.getTime() - dateA.getTime();
  });

// ─── Fallback: Legacy rendering for characters without YAML dashboard ───

const rarityColors: Record<string, string> = {
  Common: 'bg-gray-800/60 text-gray-300 border-gray-700',
  Uncommon: 'bg-green-950/40 text-green-300 border-green-800',
  Rare: 'bg-blue-950/40 text-blue-300 border-blue-800',
  Starter: 'bg-purple-950/40 text-purple-300 border-purple-800',
  Boss: 'bg-orange-950/40 text-orange-300 border-orange-800',
  Special: 'bg-pink-950/40 text-pink-300 border-pink-800',
};

const typeColors: Record<string, string> = {
  Attack: 'bg-red-950/40 text-red-300 border-red-800',
  Skill: 'bg-blue-950/40 text-blue-300 border-blue-800',
  Power: 'bg-yellow-950/40 text-yellow-300 border-yellow-800',
  Status: 'bg-gray-800/60 text-gray-400 border-gray-700',
  Curse: 'bg-purple-950/60 text-purple-400 border-purple-800',
};

const guideTypeLabels: Record<string, string> = {
  'build': 'Build Guide',
  'tier-list': 'Tier List',
  'beginner': 'Beginner Guide',
  'advanced': 'Advanced Guide',
  'character-overview': 'Character Overview',
  'roadmap': 'Roadmap',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Character mechanics descriptions (fallback only)
const characterMechanics: Record<string, { name: string; description: string; tips: string[] }> = {
  Ironclad: {
    name: 'Strength Scaling & Self-Damage',
    description: 'The Ironclad specializes in raw damage output through Strength scaling. His cards often deal self-damage as a cost for powerful effects, and he can heal back via Reaper or Feed.',
    tips: [
      'Stack Strength with Demon Form, Spot Weakness, or Inflame early in fights',
      'Use multi-hit attacks (Sword Boomerang, Pummel) to multiply Strength value',
      'Self-damage cards like Offering and Hemokinesis are strong — the HP cost is an investment',
      'Reaper with high Strength provides full heals in multi-enemy fights',
      'Exhaust synergies (Corruption, Dark Embrace, Feel No Pain) generate block while thinning your deck',
    ],
  },
  Silent: {
    name: 'Poison, Shivs & Discard',
    description: 'The Silent controls fights through poison accumulation, shiv generation, and discard synergies. She excels at defense through weakness application and intangible effects.',
    tips: [
      'Poison is your safest boss killer — Catalyst doubles/triples your poison stacks',
      'Shivs deal low individual damage but scale massively with Accuracy and strength relics',
      'Discard synergies (Acrobatics, Tactician, Reflex) generate energy and draw',
      'Wraith Form gives 3 turns of near-invincibility — time it for boss phases',
      'Footwork makes your block cards nearly twice as effective',
    ],
  },
  Defect: {
    name: 'Orbs & Power Scaling',
    description: 'The Defect channels elemental orbs into orb slots. Each orb provides passive effects — Lightning for damage, Frost for block, Dark for scaling damage, Plasma for energy.',
    tips: [
      'Frost orbs + Focus are the strongest defensive engine in the game',
      'Lightning orbs provide consistent chip damage that adds up over long fights',
      'Dark orbs accumulate damage each turn — use Dualcast/Multi-Cast to release them at the right moment',
      'Plasma orbs generate extra energy, fueling massive turns',
      'Power cards (Defragment, Capacitor, Biased Cognition) scale your orb output exponentially',
    ],
  },
  Regent: {
    name: 'Command & Legacy',
    description: 'The Regent commands allies through her unique Command system. She builds an army, issues tactical orders, and creates Legacy effects that persist across turns.',
    tips: [
      'Balance between summoning allies and issuing Command orders',
      'Legacy effects persist through the entire combat — prioritize them early',
      'Protect key allies with Bodyguard and positioning',
      'Venerate powers up your entire team for explosive turns',
      'Plan Command chains to maximize value from each order issued',
    ],
  },
  Necrobinder: {
    name: 'Curses & Sacrifice',
    description: 'The Necrobinder wields forbidden magic, adding Curse cards to her deck for powerful effects. She sacrifices minions and binds the dead to her will for astronomical rewards.',
    tips: [
      'Curse cards in your deck enable powerful synergies — don\'t be afraid to add them',
      'Sacrifice minions at the right moment for maximum impact',
      'Osty minions deal retaliation damage when they lose HP',
      'Doom stacks apply increasing pressure on enemies each turn',
      'Balance curse generation with deck thinning — too many curses without payoff will slow you down',
    ],
  },
};

const mechanics = characterMechanics[characterMeta.name] || null;

// ─── Render: Dashboard (new) or Legacy (fallback) ─────────────────────────
---

{
  characterDashboard ? (
    <GameThemeProvider colorScheme={gameEntry.data.colorScheme}>
      <CharacterDashboardLayout
        character={characterDashboard.data}
        game={{ name: gameEntry.data.name, slug: gameEntry.data.slug }}
        allCards={allCards}
        starterCards={starterCards}
        cardPool={cardPool}
        cardsByRarity={cardsByRarity}
        sortedRarities={sortedRarities}
        characterGuides={characterGuides}
      />
    </GameThemeProvider>
  ) : (
    <MainLayout
      title={`${characterMeta.name} — Slay the Spire 2 Character Guide | Spire Guide`}
      description={`${characterMeta.name}: ${characterMeta.role}. ${characterMeta.description} Complete card pool, starting deck, and strategy guides.`}
    >
      <GameThemeProvider colorScheme={gameEntry.data.colorScheme}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Breadcrumbs */}
        <nav aria-label="Breadcrumb" class="mb-6 text-sm">
          <ol class="flex items-center gap-1 text-text-muted">
            <li><a href="/" class="text-text-muted hover:text-primary no-underline">Home</a></li>
            <li><span class="mx-1">/</span></li>
            <li><a href={`/games/${gameSlug}/`} class="text-text-muted hover:text-primary no-underline">{gameEntry.data.name}</a></li>
            <li><span class="mx-1">/</span></li>
            <li><span class="text-text font-medium">{characterMeta.name}</span></li>
          </ol>
        </nav>

        {/* Character Header */}
        <header class="mb-10 flex flex-col md:flex-row gap-6 items-start">
          {characterMeta.image && (
            <div class="flex-shrink-0 w-full md:w-56 h-48 md:h-56 rounded-xl overflow-hidden bg-surface-dark border border-border">
              <img
                src={characterMeta.image}
                alt={characterMeta.name}
                width="400"
                height="300"
                class="w-full h-full object-cover"
                onerror={`this.parentElement.classList.add('hidden');`}
              />
            </div>
          )}
          <div>
            <h1 class="text-3xl md:text-4xl font-extrabold mb-3">{characterMeta.name}</h1>
            <p class="text-lg font-medium text-primary mb-2">{characterMeta.role}</p>
            <p class="text-text-muted max-w-2xl">{characterMeta.description}</p>
          </div>
        </header>

        {/* Stats Row */}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
          <div class="bg-surface border border-border rounded-xl p-4 text-center">
            <div class="text-2xl font-extrabold text-primary" style="font-family: var(--font-display);">{allCards.length}</div>
            <div class="text-xs text-text-muted mt-1">Cards in Pool</div>
          </div>
          <div class="bg-surface border border-border rounded-xl p-4 text-center">
            <div class="text-2xl font-extrabold text-accent-green" style="font-family: var(--font-display);">{starterCards.length}</div>
            <div class="text-xs text-text-muted mt-1">Starting Deck</div>
          </div>
          <div class="bg-surface border border-border rounded-xl p-4 text-center">
            <div class="text-2xl font-extrabold text-accent-gold" style="font-family: var(--font-display);">{characterGuides.length}</div>
            <div class="text-xs text-text-muted mt-1">Guides</div>
          </div>
          <div class="bg-surface border border-border rounded-xl p-4 text-center">
            <div class="text-2xl font-extrabold text-text-muted" style="font-family: var(--font-display);">
              {cardPool.filter(c => c.data.rarity === 'Rare').length}
            </div>
            <div class="text-xs text-text-muted mt-1">Rare Cards</div>
          </div>
        </div>

        {/* How to Play Section */}
        {mechanics && (
          <section class="mb-10 bg-surface-alt/50 border border-border rounded-xl p-6">
            <h2 class="text-xl font-bold mb-3">How to Play {characterMeta.name}</h2>
            <p class="text-text-muted mb-2 font-medium text-primary">{mechanics.name}</p>
            <p class="text-text-muted mb-4">{mechanics.description}</p>
            <h3 class="text-sm font-semibold text-text mb-2">Key Tips</h3>
            <ul class="space-y-1.5">
              {mechanics.tips.map(tip => (
                <li class="text-sm text-text-muted flex items-start gap-2">
                  <span class="text-primary mt-0.5 flex-shrink-0">▸</span>
                  {tip}
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Starting Deck */}
        {starterCards.length > 0 && (
          <section class="mb-10">
            <h2 class="text-xl font-bold mb-4">Starting Deck</h2>
            <p class="text-sm text-text-muted mb-4">
              {characterMeta.name} begins each run with these cards. Understanding your starting deck is key to making smart early card picks.
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
              {starterCards.map(card => (
                <a
                  href={`/games/${gameSlug}/cards/${card.data.slug}/`}
                  class="block bg-surface border border-border rounded-lg overflow-hidden hover:border-primary/30 hover:shadow-md transition-all no-underline group"
                >
                  {card.data.image && (
                    <div class="h-28 bg-surface-dark relative flex items-center justify-center p-1">
                      <img
                        src={card.data.image}
                        alt={card.data.name}
                        width="200"
                        height="112"
                        loading="lazy"
                        class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-300"
                        onerror={`this.parentElement.innerHTML='<span class=\\'text-text-muted text-xs\\'>${card.data.name}</span>';`}
                      />
                    </div>
                  )}
                  <div class="p-2.5">
                    <div class="flex items-center justify-between gap-1">
                      <h4 class="text-sm font-semibold text-text group-hover:text-primary transition-colors truncate">{card.data.name}</h4>
                      <span class={`text-xs font-medium px-1.5 py-0.5 rounded border ${typeColors[card.data.type] || 'bg-gray-800/60 text-gray-300 border-gray-700'}`}>
                        {card.data.type[0]}
                      </span>
                    </div>
                    <p class="text-xs text-text-muted mt-1">{card.data.energy_cost !== undefined ? `${card.data.energy_cost === 'X' ? 'X' : card.data.energy_cost}⚡` : ''}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {/* Strategy Guides */}
        <section class="mb-10">
          <h2 class="text-xl font-bold mb-4">
            {characterMeta.name} Strategy Guides
            {characterGuides.length > 0 && (
              <span class="text-sm font-normal text-text-muted ml-2">({characterGuides.length})</span>
            )}
          </h2>

          {characterGuides.length === 0 ? (
            <div class="text-center py-12 bg-surface-alt rounded-lg border border-border">
              <p class="text-text-muted text-lg">No guides yet for {characterMeta.name}.</p>
              <p class="text-text-light text-sm mt-2">Check back soon or browse other characters.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {characterGuides.map(guide => (
                <a
                  href={`/games/${gameSlug}/guides/${guide.id}/`}
                  class="block bg-surface border border-border rounded-lg p-5 hover:shadow-md hover:border-primary/30 transition-all no-underline"
                >
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="text-xs font-medium px-2 py-0.5 rounded bg-surface-alt text-text-muted border border-border">
                      {guideTypeLabels[guide.data.guideType] || guide.data.guideType}
                    </span>
                  </div>
                  <h3 class="font-semibold text-text mb-1">{guide.data.title}</h3>
                  <p class="text-sm text-text-muted line-clamp-2 mb-2">{guide.data.description}</p>
                  <time class="text-xs text-text-light" datetime={(guide.data.updatedDate || guide.data.publishDate).toISOString()}>
                    {formatDate(guide.data.updatedDate || guide.data.publishDate)}
                  </time>
                </a>
              ))}
            </div>
          )}
        </section>

        {/* Full Card Pool */}
        <section>
          <h2 class="text-xl font-bold mb-4">Card Pool</h2>
          <p class="text-sm text-text-muted mb-4">
            All {cardPool.length} cards {characterMeta.name} can obtain during a run, grouped by rarity.
          </p>

          {sortedRarities.map(rarity => (
            <div class="mb-6">
              <h3 class="text-sm font-semibold mb-3 flex items-center gap-2">
                <span class={`text-xs px-2 py-0.5 rounded-full border ${rarityColors[rarity] || ''}`}>{rarity}</span>
                <span class="text-text-muted text-xs">({cardsByRarity[rarity].length} cards)</span>
              </h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2">
                {cardsByRarity[rarity].map(card => (
                  <a
                    href={`/games/${gameSlug}/cards/${card.data.slug}/`}
                    class="block bg-surface border border-border rounded-lg overflow-hidden hover:border-primary/30 hover:shadow-sm transition-all no-underline group"
                  >
                    {card.data.image && (
                      <div class="h-24 bg-surface-dark relative flex items-center justify-center p-1">
                        <img
                          src={card.data.image}
                          alt={card.data.name}
                          width="180"
                          height="96"
                          loading="lazy"
                          class="max-h-full w-auto object-contain group-hover:scale-105 transition-transform duration-300"
                          onerror={`this.parentElement.innerHTML='<span class=\\'text-text-muted text-xs\\'>${card.data.name}</span>';`}
                        />
                      </div>
                    )}
                    <div class="p-2">
                      <div class="flex items-center justify-between gap-1">
                        <h4 class="text-xs font-semibold text-text group-hover:text-primary transition-colors truncate">{card.data.name}</h4>
                        <span class={`text-[10px] font-medium px-1 py-0.5 rounded border ${typeColors[card.data.type] || 'bg-gray-800/60 text-gray-300 border-gray-700'}`}>
                          {card.data.type[0]}
                        </span>
                      </div>
                      {card.data.effect && (
                        <p class="text-[11px] text-text-muted mt-1 line-clamp-1">
                          {card.data.effect.replace(/\*\*/g, '')}
                        </p>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </section>
      </div>
      </GameThemeProvider>
    </MainLayout>
  )
}
