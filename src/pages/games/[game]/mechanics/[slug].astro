---
import { getCollection, getEntry, render } from 'astro:content';
import ReferenceLayout from '../../../../layouts/ReferenceLayout.astro';
import MechanicDisplay from '../../../../components/reference/MechanicDisplay.astro';
import GameThemeProvider from '../../../../components/GameThemeProvider.astro';

export async function getStaticPaths() {
  const mechanics = await getCollection('mechanics', ({ data }) => data.game === 'slay-the-spire-2');
  return mechanics.map((mechanic) => ({
    params: { game: 'slay-the-spire-2', slug: mechanic.data.slug },
    props: { mechanic },
  }));
}

const { mechanic } = Astro.props;
const { Content } = await render(mechanic);

const gameEntry = await getEntry('games', 'slay-the-spire-2');

const title = `${mechanic.data.name} — Game Mechanic | STS2`;
const description = `Learn how ${mechanic.data.name} works in Slay the Spire 2. Complete mechanic guide with related cards and relics.`;
---

<GameThemeProvider colorScheme={gameEntry?.data.colorScheme}>
  <ReferenceLayout
    title={title}
    description={description}
    entityType="Mechanic"
    entityName={mechanic.data.name}
  >
    <MechanicDisplay name={mechanic.data.name} />

    <div class="prose prose-slate max-w-none">
      <Content />
    </div>
  </ReferenceLayout>
</GameThemeProvider>
