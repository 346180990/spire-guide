---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import EntityCard from '../../../../components/reference/EntityCard.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.filter(g => g.data.active).map(g => ({ params: { game: g.data.slug } }));
}

const { game } = Astro.params;
const gameName = 'Slay the Spire 2';
const mechanics = await getCollection('mechanics', ({ data }) => data.game === game);
const sorted = mechanics.sort((a, b) => a.data.name.localeCompare(b.data.name));

const title = `All Mechanics — Slay the Spire 2 Mechanic Database | Spire Guide`;
const description = `Complete database of all ${mechanics.length} mechanics in Slay the Spire 2. Learn about keywords, status effects, and game systems.`;
---

<MainLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <nav class="text-sm text-text-muted mb-4">
        <a href="/" class="hover:text-primary no-underline">Home</a>
        <span class="mx-1">/</span>
        <a href={`/games/${game}/`} class="hover:text-primary no-underline">{gameName}</a>
        <span class="mx-1">/</span>
        <span class="text-text font-medium">Mechanics</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-2">STS2 Mechanics Glossary</h1>
      <p class="text-text-muted">Learn how all <strong>{mechanics.length}</strong> game mechanics work in Slay the Spire 2.</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {sorted.map((m) => (
        <EntityCard
          href={`/games/${game}/mechanics/${m.data.slug}/`}
          name={m.data.name}
          excerpt={m.data.description}
          badges={[{ label: 'Mechanic', variant: 'default' }]}
        />
      ))}
    </div>
  </div>
</MainLayout>
