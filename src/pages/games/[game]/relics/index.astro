---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import FilterBar from '../../../../components/reference/FilterBar.astro';
import EntityCard from '../../../../components/reference/EntityCard.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.filter(g => g.data.active).map(g => ({ params: { game: g.data.slug } }));
}

const { game } = Astro.params;
const gameName = 'Slay the Spire 2';
const relics = await getCollection('relics', ({ data }) => data.game === game);

const sortedRelics = relics.sort((a, b) => a.data.name.localeCompare(b.data.name));

const title = `All Relics — Slay the Spire 2 Relic Database | Spire Guide`;
const description = `Complete database of all ${relics.length} relics in Slay the Spire 2. Browse by rarity and character.`;
---

<MainLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <nav class="text-sm text-text-muted mb-4">
        <a href="/" class="hover:text-primary no-underline">Home</a>
        <span class="mx-1">/</span>
        <a href={`/games/${game}/`} class="hover:text-primary no-underline">{gameName}</a>
        <span class="mx-1">/</span>
        <span class="text-text font-medium">Relics</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-2">Slay the Spire 2 Relics</h1>
      <p class="text-text-muted">Browse all <strong>{relics.length}</strong> relics.</p>
    </header>

    <FilterBar
      filterId="relic-filters"
      filters={[
        {
          id: 'rarity',
          label: 'Rarity',
          options: [
            { label: 'Common', value: 'Common' },
            { label: 'Uncommon', value: 'Uncommon' },
            { label: 'Rare', value: 'Rare' },
            { label: 'Boss', value: 'Boss' },
            { label: 'Starter', value: 'Starter' },
            { label: 'Shop', value: 'Shop' },
            { label: 'Event', value: 'Event' },
          ],
        },
        {
          id: 'character',
          label: 'Character',
          options: [
            { label: 'Ironclad', value: 'Ironclad' },
            { label: 'Silent', value: 'Silent' },
            { label: 'Defect', value: 'Defect' },
            { label: 'Regent', value: 'Regent' },
            { label: 'Necrobinder', value: 'Necrobinder' },
            { label: 'Universal', value: '' },
          ],
        },
      ]}
    />

    <p id="relic-filters-count" class="text-sm text-text-muted mb-4">{sortedRelics.length} results</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {sortedRelics.map((relic) => (
        <EntityCard
          href={`/games/${game}/relics/${relic.data.slug}/`}
          name={relic.data.name}
          badges={[
            { label: relic.data.rarity, variant: 'rarity' },
            ...(relic.data.character ? [{ label: relic.data.character, variant: 'character' as const }] : [{ label: 'Universal', variant: 'default' as const }]),
          ]}
          excerpt={relic.data.effect}
          image={relic.data.image}
          dataAttrs={{
            rarity: relic.data.rarity,
            character: relic.data.character || '',
          }}
        />
      ))}
    </div>
  </div>
</MainLayout>
