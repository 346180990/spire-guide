---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import EntityCard from '../../../../components/reference/EntityCard.astro';
import EntityBadge from '../../../../components/reference/EntityBadge.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.filter(g => g.data.active).map(g => ({ params: { game: g.data.slug } }));
}

const { game } = Astro.params;
const gameName = 'Slay the Spire 2';
const enemies = await getCollection('enemies', ({ data }) => data.game === game);

const bosses = enemies.filter(e => e.data.is_boss).sort((a, b) => (a.data.act || 0) - (b.data.act || 0) || a.data.name.localeCompare(b.data.name));
const elites = enemies.filter(e => e.data.is_elite).sort((a, b) => (a.data.act || 0) - (b.data.act || 0) || a.data.name.localeCompare(b.data.name));
const normal = enemies.filter(e => !e.data.is_boss && !e.data.is_elite).sort((a, b) => (a.data.act || 0) - (b.data.act || 0) || a.data.name.localeCompare(b.data.name));

const actNames: Record<number, string> = { 1: 'Overgrowth', 2: 'Underdocks', 3: 'Hive', 4: 'Glory' };

const title = `All Enemies — Slay the Spire 2 Enemy Database | Spire Guide`;
const description = `Complete database of all ${enemies.length} enemies in Slay the Spire 2. Movesets, strategies, and tips for every encounter across all 4 acts.`;
---

<MainLayout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8">
      <nav class="text-sm text-text-muted mb-4">
        <a href="/" class="hover:text-primary no-underline">Home</a>
        <span class="mx-1">/</span>
        <a href={`/games/${game}/`} class="hover:text-primary no-underline">{gameName}</a>
        <span class="mx-1">/</span>
        <span class="text-text font-medium">Enemies</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold mb-2">STS2 Enemy Bestiary</h1>
      <p class="text-text-muted max-w-2xl">
        Complete database of <strong>{enemies.length} enemies</strong> in Slay the Spire 2:
        <span class="text-red-400 ml-1">{bosses.length} bosses</span>,
        <span class="text-orange-400 ml-1">{elites.length} elites</span>,
        <span class="text-text ml-1">{normal.length} normal</span> monsters
        across all 4 acts. Click any enemy for detailed movesets, stats, and strategy tips.
      </p>
    </header>

    <!-- Quick Nav -->
    <nav class="flex flex-wrap gap-2 mb-10 pb-6 border-b border-border" aria-label="Quick navigation">
      <a href="#bosses" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-red-500/10 text-red-400 border border-red-500/20 hover:bg-red-500/20 transition-colors no-underline">👑 Bosses ({bosses.length})</a>
      <a href="#elites" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-orange-500/10 text-orange-400 border border-orange-500/20 hover:bg-orange-500/20 transition-colors no-underline">⭐ Elites ({elites.length})</a>
      <a href="#normal" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-surface-dark text-text-muted border border-border hover:border-text-muted transition-colors no-underline">Normal Monsters ({normal.length})</a>
      <a href="#act-1" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-surface-dark text-text-muted border border-border hover:border-text-muted transition-colors no-underline">Act 1</a>
      <a href="#act-2" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-surface-dark text-text-muted border border-border hover:border-text-muted transition-colors no-underline">Act 2</a>
      <a href="#act-3" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-surface-dark text-text-muted border border-border hover:border-text-muted transition-colors no-underline">Act 3</a>
      <a href="#act-4" class="text-xs font-semibold px-3 py-1.5 rounded-full bg-surface-dark text-text-muted border border-border hover:border-text-muted transition-colors no-underline">Act 4</a>
    </nav>

    <!-- Bosses -->
    <section id="bosses" class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <h2 class="text-2xl font-bold">👑 Bosses</h2>
        <span class="text-sm text-text-muted">({bosses.length} enemies)</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {bosses.map((e) => (
          <EntityCard
            href={`/games/${game}/enemies/${e.data.slug}/`}
            name={e.data.name}
            subtitle={e.data.hp_range ? `${e.data.hp_range} HP` : undefined}
            badges={[
              ...(e.data.act ? [{ label: `${actNames[e.data.act] || `Act ${e.data.act}`}`, variant: 'default' as const }] : []),
              { label: 'Boss', variant: 'rarity' as const },
            ]}
            excerpt={e.data.weakness}
            image={e.data.image}
          />
        ))}
      </div>
    </section>

    <!-- Elites -->
    <section id="elites" class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <h2 class="text-2xl font-bold">⭐ Elites</h2>
        <span class="text-sm text-text-muted">({elites.length} enemies)</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {elites.map((e) => (
          <EntityCard
            href={`/games/${game}/enemies/${e.data.slug}/`}
            name={e.data.name}
            subtitle={e.data.hp_range ? `${e.data.hp_range} HP` : undefined}
            badges={[
              ...(e.data.act ? [{ label: `${actNames[e.data.act] || `Act ${e.data.act}`}`, variant: 'default' as const }] : []),
              { label: 'Elite', variant: 'rarity' as const },
            ]}
            excerpt={e.data.weakness}
            image={e.data.image}
          />
        ))}
      </div>
    </section>

    <!-- Normal Monsters by Act -->
    <section id="normal" class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <h2 class="text-2xl font-bold">Normal Monsters</h2>
        <span class="text-sm text-text-muted">({normal.length} enemies)</span>
      </div>
    </section>

    {[1, 2, 3, 4].map(act => {
      const actEnemies = normal.filter(e => e.data.act === act);
      if (actEnemies.length === 0) return null;
      return (
        <section id={`act-${act}`} class="mb-10">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <EntityBadge label={`Act ${act}: ${actNames[act]}`} variant="default" />
            <span class="text-sm text-text-muted font-normal">({actEnemies.length} enemies)</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {actEnemies.map((e) => (
              <EntityCard
                href={`/games/${game}/enemies/${e.data.slug}/`}
                name={e.data.name}
                subtitle={e.data.hp_range ? `${e.data.hp_range} HP` : undefined}
                badges={[
                  ...(e.data.act ? [{ label: `${actNames[e.data.act] || `Act ${e.data.act}`}`, variant: 'default' as const }] : []),
                ]}
                excerpt={e.data.weakness}
                image={e.data.image}
              />
            ))}
          </div>
        </section>
      );
    })}
  </div>
</MainLayout>
