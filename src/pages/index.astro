---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getGameAssets } from '../lib/game-assets';

const gameEntry = await getEntry('games', 'slay-the-spire-2');
const guideTypeLabels: Record<string, string> = {
  'build': 'Build Guide',
  'tier-list': 'Tier List',
  'beginner': 'Beginner Guide',
  'advanced': 'Advanced Guide',
  'character-overview': 'Character Overview',
  'roadmap': 'Roadmap',
};

const phaseLabels: Record<string, string> = {
  'research': 'Community Research',
  'verified': 'Player Verified',
  'authoritative': 'Authoritative',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Get all guides
const allGuides = await getCollection('guides');
const guides = allGuides
  .filter(g => g.data.game === 'slay-the-spire-2')
  .sort((a, b) => {
    const dateA = a.data.updatedDate || a.data.publishDate;
    const dateB = b.data.updatedDate || b.data.publishDate;
    return dateB.getTime() - dateA.getTime();
  });

// Get card/relic/potion counts for stats
const allCards = await getCollection('cards', ({ data }) => data.game === 'slay-the-spire-2');
const allRelics = await getCollection('relics', ({ data }) => data.game === 'slay-the-spire-2');
const allPotions = await getCollection('potions', ({ data }) => data.game === 'slay-the-spire-2');

const assets = getGameAssets({
  steamAppId: gameEntry?.data.steamAppId,
  coverImage: gameEntry?.data.coverImage,
  heroImage: gameEntry?.data.heroImage,
});

const characters = gameEntry?.data.characters || [];

// Character gradients for cards
const characterGradients: Record<string, string> = {
  Ironclad: 'linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #dc2626 100%)',
  Silent: 'linear-gradient(135deg, #14532d 0%, #166534 50%, #22c55e 100%)',
  Defect: 'linear-gradient(135deg, #1e3a5f 0%, #1e40af 50%, #3b82f6 100%)',
  Regent: 'linear-gradient(135deg, #713f12 0%, #92400e 50%, #f59e0b 100%)',
  Necrobinder: 'linear-gradient(135deg, #3b0764 0%, #6b21a8 50%, #a855f7 100%)',
};

const characterIcons: Record<string, string> = {
  Ironclad: '<path d="M14 8V3H10v5M8 21V11m0 0l2-4h4l2 4v10M8 11H6a2 2 0 00-2 2v6a2 2 0 002 2h2M16 11h2a2 2 0 012 2v6a2 2 0 01-2 2h-2" stroke="white" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  Silent: '<path d="M12 2L3 7v5c0 5.5 4 10.5 9 12 5-1.5 9-6.5 9-12V7l-9-5z" stroke="white" fill="none" stroke-width="1.5"/><path d="M9 12l2 2 4-4" stroke="white" fill="none" stroke-width="1.5" stroke-linecap="round"/>',
  Defect: '<circle cx="12" cy="12" r="10" stroke="white" fill="none" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="white" fill="none" stroke-width="1.5"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="white" stroke-width="1" opacity="0.5"/>',
  Regent: '<path d="M12 2l2.4 7.4H22l-6 4.8 2.3 7.2L12 17l-6.3 4.4 2.3-7.2-6-4.8h7.6L12 2z" stroke="white" fill="none" stroke-width="1.2"/>',
  Necrobinder: '<path d="M12 2C8 2 4 6 3 12c1 6 5 10 9 10 3 0 5-2 7-5 2-3 4-3 3 0-1 4-3 7-7 7" stroke="white" fill="none" stroke-width="1.5"/><circle cx="10" cy="9" r="1.5" fill="white" opacity="0.5"/><circle cx="15" cy="9" r="1.5" fill="white" opacity="0.5"/>',
};
---

<MainLayout
  title="Slay the Spire 2 Strategy Guides & Card Database"
  description="Complete Slay the Spire 2 strategy guide site. Card database with upgrade comparisons, relic catalog, character build guides, and detailed act-by-act walkthroughs."
>
  <!-- Hero Banner -->
  {assets.heroImage ? (
    <div class="relative w-full h-72 md:h-96 overflow-hidden bg-surface-dark">
      <img
        src={assets.heroImage}
        alt="Slay the Spire 2 hero banner"
        width="1920"
        height="620"
        fetchpriority="high"
        class="w-full h-full object-cover"
        onerror={`this.style.display='none';this.parentElement.classList.add('bg-dungeon','h-72','md:h-96');`}
      />
      <div class="absolute inset-0 bg-gradient-overlay-strong"></div>
      <div class="absolute bottom-0 left-0 right-0 p-8 md:p-12">
        <div class="max-w-7xl mx-auto text-center">
          <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-text mb-4 drop-shadow-lg">
            Slay the Spire 2
          </h1>
          <p class="text-lg md:text-xl text-text/85 max-w-2xl mx-auto drop-shadow-md">
            Complete strategy guides, card database, and build references for the genre-defining roguelike deckbuilder.
          </p>
        </div>
      </div>
    </div>
  ) : (
    <section class="bg-dungeon py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-text mb-6">
          Slay the Spire 2 Strategy Guides
        </h1>
        <p class="text-lg md:text-xl text-text/80 max-w-2xl mx-auto">
          Complete strategy guides, card database, and build references for the genre-defining roguelike deckbuilder.
        </p>
      </div>
    </section>
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 -mt-8 relative z-10 mb-12">
      {[
        { count: allCards.length, label: 'Cards', href: '/games/slay-the-spire-2/cards/' },
        { count: allRelics.length, label: 'Relics', href: '/games/slay-the-spire-2/relics/' },
        { count: allPotions.length, label: 'Potions', href: '/games/slay-the-spire-2/potions/' },
        { count: guides.length, label: 'Guides', href: '#guides' },
      ].map(stat => (
        <a
          href={stat.href}
          class="block bg-surface border border-border rounded-xl p-4 text-center hover:border-primary/30 hover:shadow-lg transition-all no-underline"
        >
          <div class="text-2xl md:text-3xl font-extrabold text-primary" style="font-family: var(--font-display);">
            {stat.count}
          </div>
          <div class="text-sm text-text-muted mt-1">{stat.label}</div>
        </a>
      ))}
    </div>

    <!-- Characters -->
    {characters.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6">Characters</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {characters.map(ch => {
            const charGuides = guides.filter(g => g.data.character === ch.name);
            const charCards = allCards.filter(c => c.data.character === ch.name);
            return (
              <a
                href={`/games/slay-the-spire-2/characters/${ch.slug}/`}
                class="block bg-surface border border-border rounded-xl overflow-hidden hover:shadow-md hover:border-primary/30 transition-all no-underline group"
              >
                <!-- Character visual header -->
                <div
                  class="h-40 relative flex items-center justify-center overflow-hidden bg-surface-dark"
                >
                  {ch.image ? (
                    <>
                      <img
                        src={ch.image}
                        alt={ch.name}
                        width="400"
                        height="160"
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        onerror={`this.style.display='none';this.parentElement.style.background='${characterGradients[ch.name] || 'linear-gradient(135deg, #374151, #6b7280)'}';this.parentElement.querySelector('.fallback-icon').style.display='flex';`}
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-surface/80 to-transparent"></div>
                    </>
                  ) : null}
                  <div
                    class="absolute inset-0 items-center justify-center fallback-icon"
                    class:list={[{'hidden flex': !!ch.image, 'flex': !ch.image}]}
                    style={`background: ${characterGradients[ch.name] || 'linear-gradient(135deg, #374151, #6b7280)'};`}
                  >
                    <div class="absolute inset-0 bg-noise"></div>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-14 h-14 relative z-10 opacity-30 group-hover:opacity-50 transition-opacity" fill="none">
                      <Fragment set:html={characterIcons[ch.name] || '<circle cx="12" cy="12" r="10" stroke="white" fill="none" stroke-width="1.5"/>'} />
                    </svg>
                  </div>
                  <!-- Character name overlay at bottom -->
                  <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-black/60 to-transparent">
                    <h3 class="text-base font-bold text-white drop-shadow-md">{ch.name}</h3>
                  </div>
                </div>
                <div class="p-4">
                  <p class="text-xs text-primary font-medium mb-2">{ch.role}</p>
                  <p class="text-xs text-text-muted">
                    {charCards.length} cards · {charGuides.length} guide{charGuides.length !== 1 ? 's' : ''}
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Reference Database -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6">Reference Database</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {[
          {
            href: '/games/slay-the-spire-2/cards/',
            icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="8" y1="10" x2="16" y2="10" stroke-width="1.5" stroke-linecap="round"/><line x1="8" y1="14" x2="14" y2="14" stroke-width="1.5" stroke-linecap="round"/></svg>',
            label: 'Cards',
            count: allCards.length
          },
          {
            href: '/games/slay-the-spire-2/relics/',
            icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3h8l4 5-8 8-8-8 4-5z" stroke-linejoin="round"/><path d="M12 16v5"/></svg>',
            label: 'Relics',
            count: allRelics.length
          },
          {
            href: '/games/slay-the-spire-2/potions/',
            icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3h6M10 3v5.5L5 18a3 3 0 005.6 2h2.8A3 3 0 0019 18l-5-9.5V3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
            label: 'Potions',
            count: allPotions.length
          },
          {
            href: '/games/slay-the-spire-2/mechanics/',
            icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8" stroke-dasharray="4 3"/></svg>',
            label: 'Mechanics',
            count: '~50'
          },
          {
            href: '/games/slay-the-spire-2/enemies/',
            icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r="1.5" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r="1.5" fill="currentColor" stroke="none"/><path d="M8 15c2-2 6-2 8 0" stroke-linecap="round"/></svg>',
            label: 'Enemies',
            count: '~8'
          },
        ].map(({ href, icon, label, count }) => (
          <a
            href={href}
            class="block bg-surface border border-border rounded-lg p-4 hover:shadow-md hover:border-primary/30 transition-all no-underline text-center"
          >
            <div class="mb-2 text-primary"><Fragment set:html={icon} /></div>
            <div class="font-semibold text-text text-sm">{label}</div>
            <div class="text-xs text-text-muted mt-1">{count} {label.toLowerCase()}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- Guides -->
    <section class="pb-12" id="guides">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">Strategy Guides</h2>
        <a href="/games/slay-the-spire-2/" class="text-sm text-primary hover:text-primary-dark no-underline">
          All guides →
        </a>
      </div>
      {guides.length === 0 ? (
        <div class="text-center py-12 bg-surface-alt rounded-lg border border-border">
          <p class="text-text-muted text-lg">Guides coming soon!</p>
          <p class="text-text-light text-sm mt-2">
            We're working on our first batch of strategy guides. Check back soon!
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {guides.map(guide => (
            <a
              href={`/games/slay-the-spire-2/guides/${guide.id}/`}
              class="block bg-surface border border-border rounded-lg overflow-hidden hover:shadow-md hover:border-primary/30 transition-all no-underline group"
            >
              {guide.data.featuredImage && (
                <div class="h-36 overflow-hidden bg-surface-dark relative">
                  <img
                    src={guide.data.featuredImage}
                    alt=""
                    width="600"
                    height="144"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    onerror={`this.style.display='none';this.parentElement.classList.add('hidden');`}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-surface/80 to-transparent"></div>
                </div>
              )}
              <div class="p-5">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-xs font-medium px-2 py-0.5 rounded bg-surface-alt text-text-muted border border-border">
                    {guideTypeLabels[guide.data.guideType] || guide.data.guideType}
                  </span>
                  {guide.data.character && (
                    <span class="text-xs text-primary font-medium">{guide.data.character}</span>
                  )}
                  <span class="text-xs text-text-muted">{phaseLabels[guide.data.phase]}</span>
                </div>
                <h3 class="font-semibold text-text group-hover:text-primary transition-colors mb-1">{guide.data.title}</h3>
                <p class="text-sm text-text-muted line-clamp-2 mb-2">{guide.data.description}</p>
                <time class="text-xs text-text-light" datetime={(guide.data.updatedDate || guide.data.publishDate).toISOString()}>
                  {formatDate(guide.data.updatedDate || guide.data.publishDate)}
                </time>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

  </div>
</MainLayout>
