# 策略助手 Web 的环境变量（systemd EnvironmentFile）
# 改完执行: systemctl restart strategy-web
# 生成随机令牌: openssl rand -hex 16

# --- 监听 ---
# 公网访问必须是 0.0.0.0；只想反代到 127.0.0.1 的话改回来
SA_HOST=0.0.0.0
SA_PORT=8090

# --- 访问令牌（0.0.0.0 监听时必填！留空=谁都能看）---
# 浏览器打开 http://IP:8090/?token=这里这一串
SA_TOKEN=CHANGE_ME_用_openssl_rand_hex_16_生成

# --- 定时任务（北京时间，逗号分隔）---
SA_SCHED_ENABLED=1
SA_SCHEDULE=08:45,18:00

# --- 微信推送（可选，默认关）---
SA_PUSH_ENABLED=0
# SA_PUSH_PROVIDER=wecom-bot
# SA_WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 想用企业微信应用 / ServerChan / PushPlus 时见 web/README.md

# --- 其它配置 ---
# 更复杂的项（标的清单、策略默认参数、push 详细字段）写在 web/config.json，
# 以 config.example.json 为模板；环境变量优先级更高。
