# Google Analytics 4 — Measurement ID (starts with "G-")
# Get this from: GA4 Admin → Data Streams → Your Stream → Measurement ID
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense — Publisher ID (starts with "ca-pub-")
# Get this from: AdSense Dashboard → Account → Account info → Publisher ID
PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Site URL for production (used in canonical URLs, sitemaps, etc.)
# Set this to your actual domain in Cloudflare Pages environment
SITE_URL=https://spireguide.top
