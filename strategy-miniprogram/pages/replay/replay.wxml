<view class="page-wrap">

  <view wx:if="{{error}}" class="info-bar danger-bar">{{error}}</view>

  <view class="card">
    <view class="title-sm">选择回看日期</view>
    <view class="tiny mt8">只能查看「当时可知道」的信号：日线策略使用当日已完成的行情，结果适用于下一交易日。</view>

    <view class="row mt16 gap12">
      <picker mode="date" value="{{pickDate}}" start="{{startBound}}" end="{{endBound}}" bindchange="onDateChange" class="flex1">
        <view class="input row between">
          <text>{{pickDate || '选择日期'}}</text>
          <text class="tiny">▾</text>
        </view>
      </picker>
      <button class="btn btn-ghost btn-small" bindtap="onPrevDay">前一天</button>
      <button class="btn btn-ghost btn-small" bindtap="onNextDay">后一天</button>
    </view>

    <view wx:if="{{notice}}" class="info-bar warn-bar mt12">{{notice}}</view>
    <view class="row between mt12">
      <text class="tiny">最近交易日 {{latestDate}}</text>
      <text class="tiny" bindtap="onBackLatest">回到最新 ›</text>
    </view>
  </view>

  <view class="card">
    <view class="row between">
      <view class="flex1">
        <view class="sub">当日盘后结论</view>
        <view class="big mt8">{{conclusionText}}</view>
        <view class="sub mt8">{{reason}}</view>
      </view>
      <status-pill text="{{statusLabel}}" tone="{{statusTone}}" />
    </view>

    <view class="divider"></view>

    <view class="row between">
      <view class="flex1">
        <view class="tiny">数据截至</view>
        <view class="bold mono">{{dataAsOf}}</view>
      </view>
      <view class="flex1">
        <view class="tiny">计算完成</view>
        <view class="bold mono">{{computedAt}}</view>
      </view>
      <view class="flex1">
        <view class="tiny">信号适用</view>
        <view class="bold mono">{{appliesTo}}</view>
      </view>
    </view>
  </view>

  <view class="info-bar">历史信号仅使用所选时点可获得的数据；不会用今天的行情解释过去。</view>

  <view class="card" wx:if="{{hasItems}}">
    <view wx:for="{{items}}" wx:key="symbol">
      <view class="row between">
        <view class="flex1">
          <view class="title-sm">
            {{item.name}}
            <text class="pill pill-{{item.tone}}">{{item.actionLabel}}</text>
          </view>
          <view class="sub mt8">{{item.reason}}</view>
          <view class="tiny mt8">数据截至 {{item.dataAsOf}} · 适用 {{item.appliesTo}}</view>
        </view>
        <view class="mono bold">{{item.valueText}}</view>
      </view>
      <view class="divider"></view>
    </view>
  </view>

  <view wx:if="{{!hasItems && !loading}}" class="card">
    <view class="empty">
      <view class="empty-title">该日期没有可用信号</view>
      <view>可能是行情长度不足（需要 N+M 根预热）或数据源未覆盖该日期。</view>
    </view>
  </view>
</view>
