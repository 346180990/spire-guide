/* 全局样式 —— 浅色工具型金融视觉，取自 spec/量化策略App界面原型拼贴.png 与原型 HTML 的配色 */

page {
  background: #F5F7FB;
  color: #152238;
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page-wrap {
  padding: 20rpx 24rpx 40rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border: 1rpx solid #E8EDF4;
  border-radius: 24rpx;
  padding: 26rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(28, 54, 98, 0.05);
}
.card-flat {
  box-shadow: none;
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* ---------- 文本 ---------- */
.title { font-size: 30rpx; font-weight: 600; color: #152238; }
.title-sm { font-size: 26rpx; font-weight: 600; color: #152238; }
.sub { font-size: 24rpx; color: #748198; }
.tiny { font-size: 22rpx; color: #94A1B5; }
.big { font-size: 44rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.mono { font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }
.up { color: #E65353; }
.down { color: #11966D; }
.warn { color: #DC8A22; }
.muted { color: #94A1B5; }
.bold { font-weight: 600; }

/* ---------- 布局 ---------- */
.row { display: flex; align-items: center; }
.row-top { display: flex; align-items: flex-start; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.flex1 { flex: 1; min-width: 0; }
.gap8 { gap: 8rpx; }
.gap12 { gap: 12rpx; }
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; }
.mb8 { margin-bottom: 8rpx; }

.divider {
  height: 1rpx;
  background: #EDF1F7;
  margin: 18rpx 0;
}

/* ---------- 标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: #EEF3FB;
  color: #53627A;
}
.pill-ok { background: #E4F8EF; color: #11966D; }
.pill-warn { background: #FFF3E0; color: #C4761A; }
.pill-danger { background: #FDEBEB; color: #D64545; }
.pill-info { background: #EAF1FF; color: #246BFE; }
.pill-up { background: #FDECEC; color: #D64545; }
.pill-down { background: #E4F8EF; color: #11966D; }
.pill-muted { background: #F1F3F7; color: #7C8AA0; }

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  border: 1rpx solid #E1E8F2;
  background: #FFFFFF;
  color: #53627A;
  margin: 0 12rpx 12rpx 0;
}
.chip-on {
  border-color: #246BFE;
  background: #EAF1FF;
  color: #1B54C7;
}

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 30rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  background: #246BFE;
  color: #FFFFFF;
  border: none;
  line-height: 1.3;
}
.btn::after { border: none; }
.btn-secondary {
  background: #EAF1FF;
  color: #1B54C7;
}
.btn-ghost {
  background: transparent;
  color: #53627A;
  border: 1rpx solid #E1E8F2;
}
.btn-small {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
}
.btn-full { width: 100%; }
.btn[disabled] { background: #C9D4E6; color: #FFFFFF; }

/* ---------- 表单 ---------- */
.field { margin-bottom: 18rpx; }
.field-label {
  font-size: 24rpx;
  color: #748198;
  margin-bottom: 8rpx;
  display: block;
}
.input {
  width: 100%;
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #E1E8F2;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #152238;
}
.input-error { border-color: #E65353; }
.field-error {
  font-size: 22rpx;
  color: #D64545;
  margin-top: 6rpx;
}
.help {
  font-size: 22rpx;
  color: #94A1B5;
  margin-top: 6rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

/* ---------- Tabs ---------- */
.tabs {
  display: flex;
  background: #EEF2F8;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #6B7A90;
  border-radius: 14rpx;
}
.tab-on {
  background: #FFFFFF;
  color: #1B54C7;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(28, 54, 98, 0.06);
}

/* ---------- 表格式行（WXML 不支持 table 标签） ---------- */
.tr {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F3F6FA;
  padding: 12rpx 0;
  font-size: 24rpx;
}
.tr-head {
  border-bottom: 1rpx solid #EDF1F7;
  padding: 8rpx 0;
}
.tr-head .td {
  color: #94A1B5;
  font-size: 22rpx;
}
.td {
  flex: 1;
  text-align: right;
  font-variant-numeric: tabular-nums;
  padding: 0 4rpx;
}
.td:first-child {
  text-align: left;
  color: #53627A;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 48rpx 24rpx;
  text-align: center;
  color: #94A1B5;
  font-size: 26rpx;
}
.empty .empty-title {
  font-size: 28rpx;
  color: #53627A;
  margin-bottom: 10rpx;
}

/* ---------- 信息条 ---------- */
.info-bar {
  background: #F0F5FF;
  border: 1rpx solid #DCE7FB;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #3A5580;
  margin-bottom: 20rpx;
}
.warn-bar {
  background: #FFF7EC;
  border-color: #FBE3C4;
  color: #8A5A16;
}
.danger-bar {
  background: #FDF0F0;
  border-color: #F8D6D6;
  color: #A33A3A;
}

/* 结论大数字 */
.hero-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}
